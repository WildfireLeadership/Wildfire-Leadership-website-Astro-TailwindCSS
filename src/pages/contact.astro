---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import { abs, ids } from '../data/site';
---

<BaseLayout
  title="Contact Us"
  description="Contact Wildfire Leadership about coaching, workshops, keynote speaking, facilitator certification, or INVEST Marriage. Email info@wildfireleadership.com."
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
  jsonLd={{ '@type': 'ContactPage', '@id': `${abs('/contact/')}#page`, url: abs('/contact/'), name: 'Contact Wildfire Leadership', about: { '@id': ids.organization }, isPartOf: { '@id': ids.website } }}
>

  <!-- Force header-light for light hero -->
  <script>document.getElementById('site-header')?.classList.add('header-light');</script>

  <!-- ===== HERO ===== -->
  <div id="contact-hero">
    <PageHero
      variant="light"
      title='Get in<br/><em>Touch</em>'
      subtitle="Every journey is unique — be it a school or college, an individual, family, business, faith & community, or leadership, we have something for you!"
    />
  </div>

  <!-- ===== CONTACT FORM — White bg ===== -->
  <section class="relative py-24 md:py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="max-w-3xl mx-auto">
        <div id="contact-heading" class="text-center mb-14">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">Reach Out</p>
          <h2 class="reveal reveal-d1 font-display text-3xl md:text-4xl lg:text-5xl text-charcoal leading-[1.1]">
            We'd love to <em>hear from you.</em>
          </h2>
          <p class="contact-direct reveal reveal-d2 mt-6 max-w-xl mx-auto text-base md:text-lg text-stone leading-relaxed">
            Email <a href="mailto:info@wildfireleadership.com">info@wildfireleadership.com</a> or use the form below. We respond within 24 business hours.
          </p>
        </div>

        <form action="https://formsubmit.co/info@wildfireleadership.com" method="POST" class="reveal reveal-d2 space-y-8">
          <input id="form-subject" type="hidden" name="_subject" value="New inquiry from Wildfire Leadership website">
          <input type="hidden" name="_captcha" value="false">
          <input type="text" name="_honey" style="display:none">
          <input type="hidden" name="_next" value="https://wildfireleadership.com/contact?sent=true">

          <!-- Interest radio group -->
          <fieldset id="interest-fieldset">
            <legend class="text-sm font-medium text-charcoal mb-4">I'm interested in...</legend>

            <div id="interest-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {[
                { label: "Ignite Students (K-12)", param: "ignite-k12" },
                { label: "Ignite Higher Ed", param: "ignite-higher-ed" },
                { label: "INVEST Marriage — Couples", param: "invest-marriage-couple" },
                { label: "INVEST Marriage — Organizations", param: "invest-marriage-organization" },
                { label: "Business & Team Workshop", param: "business" },
                { label: "Faith & Community Workshop", param: "faith" },
                { label: "Marriage & Family Mission Portrait", param: "family" },
                { label: "7 Igniters Toolkit — Planned $10/month", param: "7-igniters-toolkit" },
                { label: "Facilitator Certification", param: "facilitator" },
                { label: "Leadership Development", param: "leadership" },
                { label: "Coaching", param: "coaching" },
                { label: "Keynote Speaking", param: "speaking" },
              ].map((option) => (
                <label class="group relative flex items-center gap-3 px-4 py-3 rounded-xl border border-sand/80 bg-white cursor-pointer hover:border-ember/40 transition-colors duration-300 has-[input:checked]:border-ember has-[input:checked]:bg-ember/5">
                  <input type="radio" name="interest" value={option.label} data-interest={option.param} class="peer sr-only" />
                  <span class="w-4 h-4 shrink-0 rounded-full border-2 border-sand peer-checked:border-ember peer-checked:bg-ember relative transition-colors duration-200 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:opacity-0 peer-checked:after:opacity-100"></span>
                  <span class="text-sm text-stone peer-checked:text-charcoal transition-colors duration-200">{option.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <p id="toolkit-inquiry-note" class="hidden rounded-xl bg-warm-white p-5 text-base text-charcoal/80">You’re asking about the planned 7 Igniters™ Facilitator Toolkit at a proposed $10/month. It is not yet available. This inquiry does not start a subscription or take payment.</p>

          <!-- Shown for school and college inquiries: who is asking, and from where -->
          <div id="school-fields" class="hidden rounded-2xl bg-warm-white border border-sand/70 p-6 md:p-8 space-y-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-ember mb-2">School or college details</p>
              <p class="text-sm text-stone">Tell us about your school or campus. We’ll share our menu of services and help you find a starting point that fits.</p>
            </div>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="school-org" class="block text-sm font-medium text-charcoal mb-2">School, district or college</label>
                <input type="text" id="school-org" name="school_or_district" autocomplete="organization" class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors" />
              </div>
              <div>
                <label for="school-role" class="block text-sm font-medium text-charcoal mb-2">Your role</label>
                <select id="school-role" name="role" class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors">
                  <option value="">Choose one</option>
                  <option>Superintendent or president</option>
                  <option>Principal or dean</option>
                  <option>Counselor, career or first-year staff</option>
                  <option>Teacher or faculty</option>
                  <option>Other</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Additional details shown for INVEST Marriage inquiries -->
          <div id="invest-fields" class="hidden rounded-2xl bg-warm-white border border-sand/70 p-6 md:p-8 space-y-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-ember mb-2">INVEST Marriage details</p>
              <p class="text-sm text-stone">A few details will help Tiffany recommend the right format and next step.</p>
            </div>

            <div>
              <label for="organization" class="block text-sm font-medium text-charcoal mb-2">Church or organization</label>
              <input
                type="text"
                id="organization"
                name="organization"
                class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors"
                placeholder="Organization name, if applicable"
              />
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="couple-count" class="block text-sm font-medium text-charcoal mb-2">Estimated number of couples</label>
                <select id="couple-count" name="estimated_couples" class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors">
                  <option value="">Not sure yet</option>
                  <option value="1 couple">1 couple</option>
                  <option value="2–5 couples">2–5 couples</option>
                  <option value="6–12 couples">6–12 couples</option>
                  <option value="13–25 couples">13–25 couples</option>
                  <option value="26–50 couples">26–50 couples</option>
                  <option value="50+ couples">50+ couples</option>
                </select>
              </div>

              <div>
                <label for="invest-format" class="block text-sm font-medium text-charcoal mb-2">Preferred format</label>
                <select id="invest-format" name="preferred_format" class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors">
                  <option value="">Help me choose</option>
                  <option value="Digital / print your own">Digital / print your own — $39</option>
                  <option value="Professionally printed">Professionally printed — $59 + shipping</option>
                </select>
              </div>
            </div>

            <div>
              <label for="timeline" class="block text-sm font-medium text-charcoal mb-2">When are you hoping to begin?</label>
              <input
                type="text"
                id="timeline"
                name="desired_timeline"
                class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors"
                placeholder="For example: fall small groups, January, or still exploring"
              />
            </div>
          </div>

          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-charcoal mb-2">Name <span class="text-ember">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors"
              placeholder="Your full name"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-charcoal mb-2">Email <span class="text-ember">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors"
              placeholder="you@example.com"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-medium text-charcoal mb-2">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors"
              placeholder="(555) 123-4567"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-medium text-charcoal mb-2">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full px-4 py-3 rounded-xl border border-sand bg-white focus:border-ember focus:ring-1 focus:ring-ember/20 outline-none transition-colors resize-y"
              placeholder="Tell us about your goals, your team, or how we can help..."
            ></textarea>
          </div>

          <!-- Preferred contact method -->
          <fieldset>
            <legend class="text-sm font-medium text-charcoal mb-3">Preferred contact method</legend>
            <div class="flex items-center gap-6">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="contact_method" value="Email" checked class="peer sr-only" />
                <span class="w-4 h-4 shrink-0 rounded-full border-2 border-sand peer-checked:border-ember peer-checked:bg-ember relative transition-colors duration-200 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:opacity-0 peer-checked:after:opacity-100"></span>
                <span class="text-sm text-stone peer-checked:text-charcoal transition-colors duration-200">Email</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="contact_method" value="Phone" class="peer sr-only" />
                <span class="w-4 h-4 shrink-0 rounded-full border-2 border-sand peer-checked:border-ember peer-checked:bg-ember relative transition-colors duration-200 after:content-[''] after:absolute after:inset-[3px] after:rounded-full after:bg-white after:opacity-0 peer-checked:after:opacity-100"></span>
                <span class="text-sm text-stone peer-checked:text-charcoal transition-colors duration-200">Phone</span>
              </label>
            </div>
          </fieldset>

          <!-- Submit -->
          <div class="pt-2">
            <button
              type="submit"
              class="group inline-flex items-center gap-3 bg-charcoal text-white rounded-full px-8 py-4 text-sm font-medium tracking-wide hover:shadow-xl hover:shadow-charcoal/15 transition-all duration-400 hover:scale-[1.02]"
            >
              Send message
              <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
            </button>
          </div>

        </form>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT INFO — Warm-white bg ===== -->
  <section class="relative py-24 md:py-32 bg-warm-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-2 gap-5 md:gap-6 max-w-2xl mx-auto">

        <!-- Email -->
        <a href="mailto:info@wildfireleadership.com" class="reveal group relative block bg-white rounded-xl border border-sand/50 p-6 hover:border-ember/40 transition-colors duration-300 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember focus-visible:ring-offset-4">
          <svg class="absolute top-[30px] right-6 w-4 h-4 text-charcoal/30 group-hover:text-ember transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
          <h3 class="font-display text-xl text-charcoal mb-2">Email us</h3>
          <span class="text-sm text-stone">
            info@wildfireleadership.com
          </span>
        </a>

        <!-- Instagram -->
        <a href="https://instagram.com/wildfireleadership" target="_blank" rel="noopener noreferrer" class="reveal reveal-d1 group relative block bg-white rounded-xl border border-sand/50 p-6 hover:border-ember/40 transition-colors duration-300 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember focus-visible:ring-offset-4">
          <svg class="absolute top-[30px] right-6 w-4 h-4 text-charcoal/30 group-hover:text-ember transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
          <h3 class="font-display text-xl text-charcoal mb-2">Follow on Instagram</h3>
          <span class="text-sm text-stone">
            @wildfireleadership
          </span>
        </a>

      </div>
      <p class="reveal mt-10 text-center text-sm text-stone">Wildfire Leadership is based in Charleston, South Carolina.</p>
    </div>
  </section>

  <!-- ===== CTA CLOSER ===== -->
  <CallToAction
    title='Explore our<br/><em class="ember-gradient">tools.</em>'
    description="Discover the Mission Portrait™ and the 7 Igniters™ — two proven frameworks for uncovering purpose."
    buttonText="See the Mission Portrait"
    buttonHref="/mission-portrait"
  />

<script>
  const params = new URLSearchParams(window.location.search);

  // Pre-select interest radio if ?interest= param exists
  const interest = params.get('interest');
  const investFields = document.getElementById('invest-fields');
  const formSubject = document.getElementById('form-subject') as HTMLInputElement | null;
  const formatSelect = document.getElementById('invest-format') as HTMLSelectElement | null;

  // School and college inquiries get their own subject line, so they stand out in the inbox.
  const schoolSubjects: Record<string, string> = {
    'ignite-k12': 'Ignite Students (K-12) inquiry',
    'ignite-higher-ed': 'Ignite Higher Ed inquiry',
  };
  const schoolFields = document.getElementById('school-fields');

  const updateInvestFields = (selectedInterest = '') => {
    const isInvest = selectedInterest.startsWith('invest-marriage');
    const isSchool = selectedInterest in schoolSubjects;
    document.getElementById('toolkit-inquiry-note')?.classList.toggle('hidden', selectedInterest !== '7-igniters-toolkit');
    investFields?.classList.toggle('hidden', !isInvest);
    schoolFields?.classList.toggle('hidden', !isSchool);
    if (formSubject) {
      formSubject.value = isInvest
        ? 'New INVEST Marriage inquiry from Wildfire Leadership website'
        : isSchool
          ? schoolSubjects[selectedInterest]
          : selectedInterest === '7-igniters-toolkit'
            ? '7 Igniters Facilitator Toolkit interest — proposed $10/month'
            : 'New inquiry from Wildfire Leadership website';
    }
  };

  // Name the school in the subject line when one is given.
  document.querySelector('form')?.addEventListener('submit', () => {
    const org = (document.getElementById('school-org') as HTMLInputElement | null)?.value.trim();
    const isSchool = schoolFields && !schoolFields.classList.contains('hidden');
    if (formSubject && isSchool && org) formSubject.value = `${formSubject.value}: ${org}`;
  });

  // Older links used ?interest=education-leadership, which matches no option.
  const aliases: Record<string, string> = { 'education-leadership': 'leadership' };

  if (interest && /^[a-z0-9-]+$/.test(interest)) {
    const radio = document.querySelector(`input[name="interest"][data-interest="${aliases[interest] ?? interest}"]`) as HTMLInputElement;
    if (radio) {
      radio.checked = true;
      updateInvestFields(radio.dataset.interest || '');
    }
  }

  document.querySelectorAll<HTMLInputElement>('input[name="interest"]').forEach((radio) => {
    radio.addEventListener('change', () => updateInvestFields(radio.dataset.interest || ''));
  });

  const requestedFormat = params.get('format');
  if (formatSelect && requestedFormat === 'digital') {
    formatSelect.value = 'Digital / print your own';
  } else if (formatSelect && requestedFormat === 'printed') {
    formatSelect.value = 'Professionally printed';
  }

  // Show success message if redirected back after form submission
  if (params.get('sent') === 'true') {
    // Hide hero and section heading
    const hero = document.getElementById('contact-hero');
    const heading = document.getElementById('contact-heading');
    if (hero) hero.style.display = 'none';
    if (heading) heading.style.display = 'none';

    const form = document.querySelector('form');
    if (form) {
      form.innerHTML = `
        <div class="text-center py-16 md:py-24">
          <h2 class="font-display text-3xl md:text-4xl text-charcoal mb-4">Message sent!</h2>
          <p class="text-stone text-lg mb-6 max-w-md mx-auto">Thank you for reaching out.</p>
          <p class="text-stone text-sm mb-10 max-w-md mx-auto">We'll respond within 24 business hours. In the meantime, feel free to explore our <a href="/mission-portrait" class="text-ember underline underline-offset-2 hover:text-charcoal transition-colors">Mission Portrait™</a> or <a href="/7-igniters" class="text-ember underline underline-offset-2 hover:text-charcoal transition-colors">7 Igniters™</a>.</p>
          <a href="/" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full text-sm font-medium tracking-wide text-white bg-charcoal hover:bg-ember transition-all duration-400">
            Back to Home
            <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      `;
    }
  }
</script>

</BaseLayout>

<style>
  .contact-direct a {
    color: var(--color-ember);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-direct a:hover {
    color: var(--color-charcoal);
  }
</style>
