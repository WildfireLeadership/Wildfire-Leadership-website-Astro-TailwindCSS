---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/mission-portrait', label: 'Mission Portrait™' },
  { href: '/leadership-coaching', label: 'Leadership Coaching' },
  { href: '/workshops', label: 'Workshops' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact Us' },
];
---

<BaseLayout title="Page Not Found" description="This page could not be found. Start from the Wildfire Leadership home page or one of the links below." noindex>

  <!-- Force header-light for light hero -->
  <script>document.getElementById('site-header')?.classList.add('header-light');</script>

  <PageHero
    variant="light"
    title='Page not<br/><em>found.</em>'
    subtitle="The page you were looking for has moved or no longer exists. These are good places to pick up the trail."
  >
    <nav aria-label="Helpful links" class="reveal reveal-d3 mt-10 flex flex-wrap gap-3">
      {links.map((l) => (
        <a href={l.href} class="px-5 py-2.5 rounded-full border border-sand/80 text-sm font-medium text-charcoal hover:border-ember hover:text-ember transition-colors duration-300">{l.label}</a>
      ))}
    </nav>
  </PageHero>

</BaseLayout>
