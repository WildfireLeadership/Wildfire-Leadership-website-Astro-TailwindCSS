---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CallToAction from '../components/CallToAction.astro';

const experiences = [
  {
    title: "Marriage Mission Portrait™",
    desc: "Create a shared, visual picture of who you are as a couple and what God is building through your marriage.",
  },
  {
    title: "DISC Assessment",
    desc: "Understand how each of you communicates, responds, and makes decisions so differences become strengths.",
  },
  {
    title: "1•1•1 Rhythm",
    desc: "Build a simple, repeatable rhythm of connection that keeps your relationship from running on leftovers.",
  },
  {
    title: "Proper Portions",
    desc: "Put priorities back in their proper order and protect what matters most from the pressure of the urgent.",
  },
  {
    title: "DREAM Map",
    desc: "Dream together again, name where you want to go, and turn shared hopes into an actionable plan.",
  },
  {
    title: "Grace Place",
    desc: "Create a safer way to handle honest conversations with appreciation, humility, and grace.",
  },
];

const sessions = [
  { num: "01", title: "Invest", desc: "Choose one another again and establish an intentional foundation." },
  { num: "02", title: "Mission Portrait", desc: "Discover individual purpose and build a shared vision as a couple." },
  { num: "03", title: "Intrigue", desc: "Replace familiarity with curiosity, gratitude, and fresh appreciation." },
  { num: "04", title: "No", desc: "Protect your priorities by saying no to lesser things." },
  { num: "05", title: "Venture Out", desc: "Dream together and map practical next steps for your future." },
  { num: "06", title: "Examine", desc: "Learn a grace-filled process for honest, productive conversations." },
  { num: "07", title: "Safeguard", desc: "Strengthen the people, rhythms, and boundaries that protect your marriage." },
  { num: "08", title: "Teachable Spirit", desc: "Keep growing with humility, reflection, and lifelong investment." },
];
---

<BaseLayout
  title="INVEST Marriage — Stop Drifting. Start Investing."
  description="An interactive, Christ-centered 8-session marriage experience that helps couples reconnect, understand one another, and build a shared vision for their future."
  ogImage="/images/invest-marriage-social.png"
>

  <script>document.getElementById('site-header')?.classList.add('header-light');</script>

  <!-- ===== HERO ===== -->
  <section class="relative pt-28 md:pt-36 pb-20 md:pb-28 bg-warm-white overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[520px] h-[520px] rounded-full bg-ember/5 blur-3xl pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center">
        <div class="max-w-2xl">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-6">
            A Christ-centered marriage experience
          </p>
          <h1 class="reveal reveal-d1 font-display text-5xl md:text-6xl lg:text-7xl text-charcoal leading-[0.98]">
            Stop drifting.<br/><em>Start investing.</em>
          </h1>
          <p class="reveal reveal-d2 mt-7 text-lg md:text-xl text-stone leading-relaxed max-w-xl">
            Eight interactive sessions that help couples reconnect, understand one another, and build a shared vision for the marriage God is shaping.
          </p>

          <div class="reveal reveal-d3 mt-9 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a
              href="/contact?interest=invest-marriage-organization"
              class="group inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-sm font-medium tracking-wide text-white bg-ember hover:bg-ember-light hover:shadow-xl hover:shadow-ember/15 transition-all duration-400 hover:scale-[1.02]"
            >
              Bring INVEST to Your Community
              <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#experience" class="inline-flex items-center justify-center px-6 py-4 text-sm font-medium text-charcoal hover:text-ember transition-colors">
              See the experience
            </a>
          </div>

          <div class="reveal reveal-d4 mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-stone">
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-ember"></span>8 guided sessions</span>
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-ember"></span>Digital or printed workbooks</span>
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-ember"></span>Plug-and-play facilitator videos</span>
          </div>
        </div>

        <div class="reveal-scale relative max-w-xl mx-auto lg:mx-0">
          <div class="relative rounded-[2rem] overflow-hidden shadow-2xl shadow-charcoal/15">
            <img
              src="/images/invest-marriage-screenshot2.png"
              alt="A married couple laughing and enjoying time together"
              class="w-full aspect-[4/5] object-cover object-center"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/55 via-transparent to-transparent"></div>
            <div class="absolute left-6 right-6 bottom-6 rounded-2xl bg-white/95 backdrop-blur-sm p-5 shadow-lg">
              <img src="/images/invest-marriage-logo-color.png" alt="INVEST Marriage" class="w-48 h-auto -my-8" />
              <p class="mt-1 text-xs text-stone">One intentional investment at a time.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CLEAR OUTCOMES ===== -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">Built for real marriage</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
          Less content to consume.<br/><em>More connection to experience.</em>
        </h2>
        <p class="reveal reveal-d2 mt-6 text-base md:text-lg text-stone leading-relaxed">
          INVEST is not another marriage book to skim and forget. Every session combines a short video, meaningful conversation, and a practical tool couples can keep using long after the group ends.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-3 gap-5">
        {[
          { title: "Reconnect", desc: "Move beyond logistics and make room for curiosity, gratitude, and meaningful conversation." },
          { title: "Understand", desc: "Recognize how you are each uniquely wired and learn to work with your differences." },
          { title: "Build Together", desc: "Create shared purpose, healthy rhythms, and a practical vision for your future." },
        ].map((outcome, i) => (
          <div class:list={["reveal p-7 md:p-8 rounded-2xl bg-warm-white border border-sand/60", `reveal-d${i + 1}`]}>
            <span class="font-display text-4xl text-ember/30">0{i + 1}</span>
            <h3 class="mt-4 font-display text-2xl text-charcoal">{outcome.title}</h3>
            <p class="mt-3 text-sm text-stone leading-relaxed">{outcome.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-cream">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <TestimonialCard
        variant="large"
        quote="The INVEST Marriage curriculum has been a game-changer for our church. It's practical, engaging, and easy to implement, making it simple for small group leaders to pour into marriages."
        name="Katie Walters"
        title="Marriage Ministry Pastor, Seacoast Church, South Carolina"
      />
    </div>
  </section>

  <!-- ===== EXPERIENCE ===== -->
  <section id="experience" class="py-24 md:py-32 bg-charcoal scroll-mt-24">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20">
        <div>
          <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">What couples experience</p>
          <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-white leading-[1.05]">
            Practical tools.<br/><em class="text-ember">Lasting change.</em>
          </h2>
          <p class="reveal reveal-d2 mt-6 text-base text-white/60 leading-relaxed max-w-md">
            Couples do more than talk about a stronger marriage. They leave with a visual shared mission, a deeper understanding of one another, and rhythms they can practice immediately.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-px bg-white/10 border border-white/10 rounded-2xl overflow-hidden">
          {experiences.map((item, i) => (
            <div class:list={["reveal bg-charcoal p-7 md:p-8", `reveal-d${(i % 4) + 1}`]}>
              <div class="w-8 h-px bg-ember mb-5"></div>
              <h3 class="font-display text-xl md:text-2xl text-white">{item.title}</h3>
              <p class="mt-3 text-sm text-white/55 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== EIGHT SESSION PATH ===== -->
  <section class="py-24 md:py-32 bg-warm-white">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">The eight-session journey</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
          One clear step.<br/><em>Then the next.</em>
        </h2>
        <p class="reveal reveal-d2 mt-6 text-base md:text-lg text-stone leading-relaxed">
          Each session builds naturally on the one before it, turning insight into action without overwhelming couples with more information.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-2 gap-x-12">
        {sessions.map((session) => (
          <div class="reveal flex gap-5 py-6 border-t border-sand">
            <span class="font-display text-2xl text-ember/45 leading-none">{session.num}</span>
            <div>
              <h3 class="font-display text-xl md:text-2xl text-charcoal">{session.title}</h3>
              <p class="mt-2 text-sm text-stone leading-relaxed">{session.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PLUG-AND-PLAY FACILITATION ===== -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20 items-center">
        <div>
          <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">Made for facilitators</p>
          <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
            The videos do the teaching.<br/><em>You guide the conversation.</em>
          </h2>
          <p class="reveal reveal-d2 mt-6 text-base md:text-lg text-stone leading-relaxed">
            Every session is designed to be plug-and-play. Facilitators receive a teaching video and a clear session guide, so they can lead meaningful discussion without becoming a marriage expert or building a lesson from scratch.
          </p>
          <div class="reveal reveal-d3 mt-7 inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 text-sm text-charcoal border border-sand/70">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ember/10 text-ember">✓</span>
            No counseling degree or teaching experience required
          </div>
        </div>

        <div class="grid gap-4">
          {[
            {
              num: "01",
              title: "Open the Session Guide",
              desc: "Know the purpose, flow, discussion prompts, and materials for the session before your group arrives.",
            },
            {
              num: "02",
              title: "Press Play",
              desc: "A facilitator video delivers the core teaching for each session with consistency and clarity.",
            },
            {
              num: "03",
              title: "Guide the Conversation",
              desc: "Use the provided prompts and workbook activities to help couples apply the tools to their own marriage.",
            },
          ].map((step, i) => (
            <div class:list={["reveal flex gap-5 rounded-2xl bg-white border border-sand/60 p-6 md:p-7", `reveal-d${i + 1}`]}>
              <span class="font-display text-3xl text-ember/40 leading-none">{step.num}</span>
              <div>
                <h3 class="font-display text-xl md:text-2xl text-charcoal">{step.title}</h3>
                <p class="mt-2 text-sm text-stone leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING & FLEXIBLE DELIVERY ===== -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">Simple introductory pricing</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
          Choose the format that<br/><em>fits your group.</em>
        </h2>
        <p class="reveal reveal-d2 mt-6 text-base md:text-lg text-stone leading-relaxed">
          Every couple receives the complete eight-session experience. Choose flexible digital materials or professionally printed materials delivered for you.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="reveal p-8 md:p-10 rounded-2xl bg-warm-white border border-sand/60 flex flex-col">
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">Flexible by design</p>
          <h3 class="font-display text-3xl text-charcoal">Digital Experience</h3>
          <div class="mt-5 flex items-end gap-2">
            <span class="font-display text-6xl text-charcoal">$39</span>
            <span class="text-sm text-stone pb-2">per couple</span>
          </div>
          <p class="mt-5 text-sm text-stone leading-relaxed">
            Digital workbook access with permission to print your own materials locally—ideal for flexible timelines, distributed groups, and international partners.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-charcoal">
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Facilitator video for every session</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Interactive digital workbook materials</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>DISC, Mission Portrait™, and practical tools</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Plug-and-play session guides and prompts</span></li>
          </ul>
          <a href="/contact?interest=invest-marriage-organization&format=digital" class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-charcoal px-6 py-3.5 text-sm font-medium text-white hover:bg-ember transition-colors">
            Request Digital Details <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="reveal reveal-d1 relative p-8 md:p-10 rounded-2xl bg-charcoal flex flex-col">
          <div class="absolute top-5 right-5 rounded-full bg-ember px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white">
            Ready to distribute
          </div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">We handle the printing</p>
          <h3 class="font-display text-3xl text-white">Printed Experience</h3>
          <div class="mt-5 flex items-end gap-2">
            <span class="font-display text-6xl text-white">$59</span>
            <span class="text-sm text-white/50 pb-2">per couple + shipping</span>
          </div>
          <p class="mt-5 text-sm text-white/60 leading-relaxed">
            Professionally printed workbook materials arrive ready to distribute—ideal for churches and organizations that want a polished, turnkey experience.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-white/85">
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Everything in the Digital Experience</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Professionally printed workbook materials</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>Ready to distribute to each couple</span></li>
            <li class="flex gap-3"><span class="text-ember">✓</span><span>No local printing or assembly required</span></li>
          </ul>
          <a href="/contact?interest=invest-marriage-organization&format=printed" class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-medium text-charcoal hover:bg-ember hover:text-white transition-colors">
            Request Printed Details <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <p class="reveal mt-8 text-center text-sm text-stone">
        Planning for a larger group or multi-location rollout? Volume and organizational pricing are available.
      </p>
    </div>
  </section>

  <!-- ===== TWO AUDIENCE PATHS ===== -->
  <section class="py-24 md:py-32 bg-cream">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.28em] text-ember mb-5">A simple way to begin</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
          Start with your marriage.<br/><em>Or strengthen a community.</em>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="reveal p-8 md:p-10 rounded-2xl bg-white border border-sand/60">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember">For couples</p>
          <h3 class="mt-4 font-display text-3xl text-charcoal">Invest in what matters most.</h3>
          <p class="mt-4 text-sm md:text-base text-stone leading-relaxed">
            Experience INVEST with a small group, church, or community organization and walk through each session together.
          </p>
          <a href="/contact?interest=invest-marriage-couple" class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors">
            Find your next step <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="reveal reveal-d1 p-8 md:p-10 rounded-2xl bg-charcoal">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember">For churches & organizations</p>
          <h3 class="mt-4 font-display text-3xl text-white">Create a culture of thriving marriages.</h3>
          <p class="mt-4 text-sm md:text-base text-white/60 leading-relaxed">
            Equip facilitators with plug-and-play videos and session guides, launch groups, and scale INVEST across a church, nonprofit, veteran community, region, or partner network.
          </p>
          <a href="/contact?interest=invest-marriage-organization" class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-white hover:text-ember transition-colors">
            Bring INVEST to your community <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-white">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8">
      <TestimonialCard
        variant="large"
        quote="We facilitated an INVEST Marriage small group at our church and it was incredibly easy to lead. The conversations it sparked were so real and transforming — couples left with practical tools and a deeper connection."
        name="Jim and Jenny Benedict"
        title="Small Group Leaders, Xperience Church, Ohio"
      />
    </div>
  </section>

  <CallToAction
    image="/images/invest-marriage-screenshot1.png"
    title='Your marriage is worth<br/><em class="ember-gradient">investing in.</em>'
    description="Help couples reconnect, understand one another, and build a shared vision—one intentional investment at a time."
    buttonText="Start the Conversation"
    buttonHref="/contact?interest=invest-marriage-organization"
  />

</BaseLayout>
