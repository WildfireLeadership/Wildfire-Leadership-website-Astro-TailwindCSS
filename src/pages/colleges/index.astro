---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import IgniteTop from '../../components/ignite/IgniteTop.astro';
import IgniteAbout from '../../components/ignite/IgniteAbout.astro';
import IgnitePartners from '../../components/ignite/IgnitePartners.astro';
import IgniteScript from '../../components/ignite/IgniteScript.astro';
import IgniteClips, { type Clip } from '../../components/ignite/IgniteClips.astro';
import IgniteFigures from '../../components/ignite/IgniteFigures.astro';
import { abs, faqPage, provider, type Faq } from '../../data/site';
import '../../styles/ignite.css';
import workbookCloseup from '../../assets/images/workbook-closeup.jpg';
import framework from '../../assets/images/mission-portrait-framework.png';
import emmaClip from '../../assets/images/emma-testimonial.jpg';
import maysaClip from '../../assets/images/maysa-testimonial.jpg';
import lifestyle from '../../assets/images/lifestyle.jpg';
// Real portraits already on the live homepage; Will OK'd showing them here, 2026-11-17.
// Both have no faith content (Zeb's and Ryan's do), so they suit a public-school page.
import portraitBrenda from '../../assets/images/portrait-coleen-full.png';
import portraitSarah from '../../assets/images/portrait-sarah-full.png';
import logoHocking from '../../assets/images/school-logo-hocking.png';
import logoNorthwest from '../../assets/images/school-logo-2.png';
import logoSoutheastern from '../../assets/images/school-logo-1.png';
import logoBowlingGreen from '../../assets/images/school-logo-8.png';
import logoDefianceCollege from '../../assets/images/school-logo-4.png';

const path = '/colleges/';
const sampleRoadmap = '/images/7-igniters-college-sample-roadmap.jpg';
const colleges = [
  { logo: logoHocking, name: 'Hocking College', alpha: true },
  { logo: logoNorthwest, name: 'Northwest State Community College' },
  { logo: logoSoutheastern, name: 'Southeastern University' },
  { logo: logoBowlingGreen, name: 'Bowling Green State University' },
  { logo: logoDefianceCollege, name: 'Defiance College' },
];

// Student clips as on the old Higher Ed page. Bill, 27 November 2026: each reads Student Testimonial
// (the Higher Ed materials identify Maysa with Northwest State), with first names only.
const students: Clip[] = [
  { vimeo: '1163802453', title: 'Maysa', program: 'Student Testimonial', play: "Play Maysa's clip", length: '1:04', thumb: maysaClip, alt: 'Maysa, smiling, in her room' },
  { vimeo: '1167969792', title: 'Emma', program: 'Student Testimonial', play: "Play Emma's clip", length: '0:47', thumb: emmaClip, alt: 'Emma, seated, laughing' },
];

// Bill, 27 November 2026: titled What Is a Mission Portrait? on both pages.
const mpVideos: Clip[] = [
  { vimeo: '1166391250', title: 'What Is a Mission Portrait?', program: 'Ignite Students and Ignite Higher Ed', play: 'Play the video', length: '1:40', thumb: lifestyle, alt: 'A Mission Portrait worksheet with handwritten notes under Top 4 core values' },
];

// Bill, 27 November 2026: his live wording (commit 552cf05) for the Hocking line and the 90%+ and
// 90% figures; the 87% line and its source word for word from his email.
const partners = 'Wildfire community-college brief, across partner schools and colleges';
const outcomes = [
  {
    figs: [
      { n: '90%+', label: '90%+ report clarity on their purpose after completing a Mission Portrait.', src: partners },
      { n: '90%', label: '90% leave with a personalized roadmap and career plan.', src: partners },
      { n: '87%', label: 'Institutions report an 87% increase in leadership and personal development engagement.', src: 'Wildfire Leadership internal program data, across education partners' },
    ],
  },
];

const faqs: Faq[] = [
  {
    q: 'Which version would our college use?',
    a: 'Public colleges use the non-faith-based version. Faith-based colleges use the faith-based version.',
  },
  {
    q: 'Can students complete the online curriculum without AI?',
    a: 'Yes. Students can complete the full roadmap without AI. Two optional tools use AI to suggest career paths or next steps based on what students enter. Students choose which suggestions to explore.',
  },
  {
    q: 'Where does it fit on our campus?',
    a: 'Orientation, first-year experience courses, career services programming, student success initiatives, or a standalone workshop series.',
  },
  {
    q: 'How would we measure it?',
    a: 'Pick one measure you already track, such as first-to-second-year retention or a belonging survey, and compare students who took part with those who did not.',
  },
  {
    q: 'Does it work at a community college?',
    a: 'Yes. You can start in one course or advising group, then expand to other programs if it fits your campus.',
  },
  {
    q: 'Can we start small?',
    a: 'Yes. Start with the leadership session or one cohort, and decide on the rest afterward.',
  },
];

const jsonLd = [
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: 'Ignite Higher Ed',
    serviceType: 'Purpose and career-planning program for colleges',
    url: abs(path),
    description:
      'A purpose and career-planning program for orientation and the first-year seminar, led by a college’s own faculty and staff, using the Mission Portrait™ and the 7 Igniters™. Public colleges use the non-faith-based version.',
    provider,
    audience: { '@type': 'EducationalAudience', educationalRole: 'administrator' },
  },
  faqPage(path, faqs),
];
---

<BaseLayout
  title="Ignite Higher Ed for colleges"
  description="Ignite Higher Ed fits orientation and the first-year seminar, led by your own faculty and staff, with a non-faith-based version for public colleges. See where to start and request a 20-minute call."
  breadcrumbs={[{ name: 'Colleges', path }]}
  jsonLd={jsonLd}
  siteHeader={false}
  familyLinks={false}
>
  <div class="ig">
    <IgniteTop
      program="Ignite Higher Ed"
      links={[
        { href: '#make', label: 'What students make' },
        { href: '#igniters', label: '7 Igniters' },
        { href: '#start', label: 'Where to start' },
        { href: '#questions', label: 'Questions' },
      ]}
    />

    <main>
      <section class="hero" aria-labelledby="t">
        <div class="aside l">
          <figure>
            <Img src={portraitBrenda} alt="Brenda's Mission Portrait over a coral reef: core values optimistic, empathetic, resourceful and nurturing, her ID, mission and vision, and the line Broken crayons still color" width={240} />
            <figcaption>Brenda's Mission Portrait</figcaption>
          </figure>
        </div>
        <article class="sheet">
          <h1 id="t">Help students leave with a plan</h1>
          <p class="sub">Your faculty and staff can bring Ignite Higher Ed into orientation, first-year seminars, advising, or career services. Public colleges use the <span style="white-space:nowrap">non-faith-based version</span>.</p>
          <ul class="facts">
            <li><i class="dia"></i>Faculty and staff certified in two 90-minute sessions</li>
            <li><i class="dia"></i>A first portrait in about 90 minutes</li>
            <li><i class="dia"></i>A written quote for your campus</li>
          </ul>
          <div class="acts">
            <a class="btn" href="#reply">Request a 20-minute call</a>
          </div>
          <Img
            class="plate"
            src={workbookCloseup}
            alt="A student writing in the Core Values Word Bank pages of the Mission Portrait workbook"
            widths={[480, 760, 1170]}
            sizes="(min-width: 980px) 648px, calc(100vw - 60px)"
            priority
          />
        </article>
        <div class="aside r">
          <figure>
            <p class="lede" style="font-size:17px">Every incoming freshman at <b>Hocking College</b> participates in Ignite Higher Ed.</p>
            <figcaption>Nelsonville, Ohio</figcaption>
          </figure>
        </div>
      </section>

      <IgnitePartners heading="Our work with colleges and universities" partners={colleges} />

      <section class="band on-sand voices" aria-label="What college leaders say" data-stage>
        <div class="quotes">
          <figure class="q" data-rise>
            <blockquote>“Wildfire's curriculum gives students something most programs miss — real clarity on their purpose and a vision for their future.”</blockquote>
            <figcaption><b>Dr. Todd Hernandez</b>, President, Northwest State Community College</figcaption>
          </figure>
          <figure class="q" data-rise>
            <blockquote>“This program has been transformational for our campus. Students are more engaged, faculty are more connected, and we're seeing real results in retention and student success.”</blockquote>
            <figcaption><b>Dr. Betty Young</b>, President, Hocking College</figcaption>
          </figure>
        </div>
      </section>

      <IgniteClips lede="Hear students describe their experience and see how the Mission Portrait works." heading="Hear it from students" students={students} videos={mpVideos} />

      <section class="band on-paper split make" id="make" aria-labelledby="make-h" data-stage>
        <div>
          <h2 id="make-h" data-rise>What each student makes</h2>
          <p class="lede" data-rise>A one-page Mission Portrait: their core values, a personal motto, their mission and their vision, set over an image they choose.</p>
          <p class="lede" data-rise>Then the 7 Igniters turn that page into a plan for the years ahead.</p>
          <figure class="side-fig" data-rise>
            <Img src={framework} alt="How a Mission Portrait is laid out: core values, an ID or slogan, mission, vision and a passage or quote, shown on an example portrait" widths={[360, 540, 720]} sizes="(min-width: 980px) 340px, 100vw" kind="graphic" />
            <figcaption>How a Mission Portrait is laid out (an adult's example)</figcaption>
          </figure>
        </div>
        <div class="stack">
          <figure class="real" data-rise>
            <Img src={portraitSarah} alt="Sarah's finished Mission Portrait over a field of daisies: core values family oriented, authentic, loyal and passionate, her ID, mission and vision, and the line There is no courage without vulnerability" widths={[480, 720, 960, 1280]} sizes="(min-width: 980px) 44vw, calc(100vw - 48px)" alpha />
            <figcaption>Sarah's Mission Portrait</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-field split igniters" id="igniters" aria-labelledby="ig-h" data-stage>
        <div>
          <h2 id="ig-h" data-rise>From purpose to a career plan</h2>
          <p class="lede" data-rise>The 7 Igniters is a simple, seven-step career-discovery process that starts from each student's own purpose.</p>
          <p class="lede" data-rise>The Mission Portrait helps students name who they are and what matters to them. The 7 Igniters connect that purpose with their strengths, dreams, assessment insights, possible career paths and practical next steps.</p>
          <p class="lede" data-rise><b>Each student leaves with a personal roadmap.</b></p>
          <div class="try" data-rise>
            <h3>A sample for first-year experience or advising</h3>
            <p>Igniter 7 shows how the portrait and the seven steps lead to something a student can act on. Ask each student to:</p>
            <ol>
              <li>Pick one career or education option they are curious about</li>
              <li>Name one action they can take this week</li>
              <li>Set a date</li>
              <li>Name someone who can help</li>
            </ol>
            <p class="eg">For example, asking an advisor to help set up a job shadow.</p>
          </div>
          <p class="next-step" data-rise><a class="link" href={sampleRoadmap} target="_blank" rel="noopener">See a sample student roadmap</a></p>
        </div>
        <figure data-rise>
          <a href={sampleRoadmap} target="_blank" rel="noopener"><img src={sampleRoadmap} width="1836" height="2376" loading="lazy" decoding="async" alt="Sample 7 Igniters roadmap for Jasmine Carter, a fictional community college student exploring a nursing career" /></a>
          <figcaption>A sample roadmap for a fictional community college student pursuing nursing.</figcaption>
        </figure>
      </section>

      <section class="band on-sand start" id="start" aria-labelledby="start-h" data-stage>
        <h2 id="start-h" data-rise>Where to start</h2>
        <p class="lede" data-rise>Start with one session for your leaders or explore a pilot with a single course or student group. We’ll send a menu of services or a written quote for your campus.</p>
        <p class="next-step" data-rise><a class="btn ink" href="/contact?interest=ignite-higher-ed">Request pricing for your campus</a></p>
      </section>

      <section class="band on-field proof" id="colleges" aria-labelledby="colleges-h" data-stage>
        <div class="split">
          <div>
            <h2 id="colleges-h" data-rise>How campuses use Ignite</h2>
            <p class="lede" data-rise>Hocking College is a public college in Nelsonville, Ohio. Every incoming freshman at Hocking College participates in Ignite Higher Ed:</p>
            <ul class="model">
              <li data-rise><i class="dia"></i>First-year students take it in the Pathways course</li>
              <li data-rise><i class="dia"></i>Each student makes a Mission Portrait, then works through the 7 Igniters</li>
            </ul>
            <p class="lede stat" data-rise>At Hocking College, 94% of students reported clarity on their purpose after completing the program.</p>
            <p class="stat-src" data-rise>Hocking College internal reporting.</p>
            <figure class="q" data-rise>
              <blockquote>“As the Executive Director of Student Engagement and Success at Hocking College, I have had the privilege of observing firsthand the profound impact of the “Mission Portrait” and “7 Igniters” program on our first-year students in the Pathways course. This initiative is truly transformative, going far beyond a conventional academic plan to deeply engage students in discovering their authentic selves and charting a course for enduring success during the first semester and beyond.”</blockquote>
              <figcaption><b>Terry Koons</b>, Executive Director of Student Engagement and Success, Hocking College</figcaption>
            </figure>
          </div>
          <div class="namecard" data-rise>
            <h3>Northwest State Community College</h3>
            <p>Started with leadership teams and brought the framework into selected departments.</p>
          </div>
        </div>
        <div class="results" data-rise>
          <h3>Wildfire program outcomes</h3>
          <IgniteFigures groups={outcomes} />
        </div>
        <p class="next-step" data-rise>Explore what would fit your campus? <a class="btn" href="#reply">Request a 20-minute call</a></p>
      </section>

      <section class="band on-paper ask" id="questions" aria-labelledby="q-h" data-stage>
        <div>
          <h2 id="q-h" data-rise>Questions colleges ask first</h2>
          {faqs.map((f, i) => (
            <details data-rise open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <form class="card" id="reply" data-rise data-school-form data-program="Ignite Higher Ed" action="https://formsubmit.co/info@wildfireleadership.com" method="POST" aria-labelledby="reply-h">
          <h2 id="reply-h">Plan your first year</h2>
          <p class="s">A 20-minute call, then a written quote.</p>
          <p class="s" data-sent hidden><b>Thank you.</b> Your request reached us. We reply within 24 business hours.</p>
          <input type="hidden" name="_subject" value="Ignite Higher Ed inquiry" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_next" value="https://www.wildfireleadership.com/colleges/?sent=true#reply" />
          <input type="hidden" name="interest" value="Ignite Higher Ed" />
          <div class="fields">
            <label>Your name<input name="name" autocomplete="name" required /></label>
            <label>Your role
              <select name="role" required>
                <option value="" selected disabled>Choose one</option>
                <option>President or vice president</option><option>Dean of students</option><option>First-year experience</option><option>Career services</option><option>Faculty</option><option>Other</option>
              </select>
            </label>
            <label class="full">College or university<input name="college" autocomplete="organization" required data-org /></label>
            <label>Where you would start
              <select name="start" required>
                <option value="" selected disabled>Choose one</option>
                <option>Orientation</option><option>First-year seminar</option><option>Leadership session only</option><option>Not sure yet</option>
              </select>
            </label>
            <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          </div>
          <button class="btn" type="submit">Request a 20-minute call</button>
          <p class="alt">Or email <a href="mailto:info@wildfireleadership.com">info@wildfireleadership.com</a>. We reply within 24 business hours.</p>
        </form>
      </section>
    </main>

    <IgniteAbout program="Ignite Higher Ed" other={{ href: '/schools/', label: 'Ignite Students, for K-12 schools' }} />
  </div>
  <IgniteScript />
</BaseLayout>
