---
/**
 * Ignite Higher Ed for colleges. Replaces /education/higher-ed (redirected in vercel.json).
 * Built from the overnight audit concept, 17 November 2026, then Bill's notes of the same
 * evening. Hocking is the model; Northwest State is listed for what it uses Ignite for
 * (leadership teams), not as student proof. The placeholder NSCC figures, the Hocking
 * figures that matched another school's, and the reworded quote are gone. No college
 * quote shows until one is confirmed with its speaker. Prices are the CSU menu's
 * (src/data/ignite.ts), and the estimator uses only those.
 * Bill's notes of 18 November: Dr. Todd Hernandez's homepage quote leads (Bill approved
 * the exact wording); Hocking reads "Every incoming freshman at Hocking College
 * participates in Ignite Higher Ed" (Bill confirmed it; the orientation timing is not
 * confirmed, so it is gone); Terry Koons's testimonial of 13 June 2025 supports the
 * Hocking Pathways example and needs Terry's OK on wording and title before launch.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import IgniteTop from '../../components/ignite/IgniteTop.astro';
import IgniteAbout from '../../components/ignite/IgniteAbout.astro';
import IgniteScript from '../../components/ignite/IgniteScript.astro';
import { abs, faqPage, provider, type Faq } from '../../data/site';
import { PRICES, usd, certCost, sessionCost, IGNITERS_SAMPLE } from '../../data/ignite';
import '../../styles/ignite.css';
import workbookCloseup from '../../assets/images/workbook-closeup.jpg';
import framework from '../../assets/images/mission-portrait-framework.png';
// Real portraits already on the live homepage; Will OK'd showing them here, 2026-11-17.
// Both have no faith content (Zeb's and Ryan's do), so they suit a public-school page.
import portraitBrenda from '../../assets/images/portrait-coleen-full.png';
import portraitSarah from '../../assets/images/portrait-sarah-full.png';
import sampleRoadmap from '../../assets/images/7-igniters-sample-roadmap.png';
import logoHocking from '../../assets/images/school-logo-hocking.png';
import logoNorthwest from '../../assets/images/school-logo-2.png';

const path = '/colleges/';

// Defaults the estimator opens with (IgniteScript recalculates the same way).
const L = PRICES.sessionLeaders, F = 6;
const LIC = PRICES.collegeLicense.find((t) => t.key === 'freshmen')!;
const session = sessionCost(L), cert = certCost(F);
const total = session + cert + LIC.price;

const faqs: Faq[] = [
  {
    q: 'Is there religious content?',
    a: 'Public colleges use the non-faith-based version. We are reviewing the language now to make sure the 7 Igniters app aligns with it. A faith-based version exists for faith-based colleges.',
  },
  {
    q: 'Where does it fit on our campus?',
    a: 'Orientation, first-year experience courses, career services programming, student success initiatives, or a standalone workshop series.',
  },
  {
    q: 'How would we measure it?',
    a: 'Pick one measure you already track, such as first-to-second-year retention or a belonging survey, and compare students who took part with those who did not.',
  },
  {
    q: 'Does it work at a community college?',
    a: 'Yes. Every incoming freshman at Hocking College participates in Ignite Higher Ed, and Northwest State Community College uses it with its leadership teams.',
  },
  {
    q: 'Can we start small?',
    a: 'Yes. Start with the leadership session or one cohort, and decide on the rest afterward.',
  },
];

const jsonLd = [
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: 'Ignite Higher Ed',
    serviceType: 'Purpose and career-planning program for colleges',
    url: abs(path),
    description:
      'A purpose and career-planning program for orientation and the first-year seminar, led by a college’s own faculty and staff, using the Mission Portrait™ and the 7 Igniters™. Public colleges use the non-faith-based version.',
    provider,
    audience: { '@type': 'EducationalAudience', educationalRole: 'administrator' },
  },
  faqPage(path, faqs),
];
---

<BaseLayout
  title="Ignite Higher Ed for colleges"
  description="Ignite Higher Ed fits orientation and the first-year seminar, led by your own faculty and staff, with a non-faith-based version for public colleges. See the first-year cost and request a 20-minute call."
  breadcrumbs={[{ name: 'Colleges', path }]}
  jsonLd={jsonLd}
  siteHeader={false}
  familyLinks={false}
>
  <div class="ig">
    <IgniteTop
      program="Ignite Higher Ed"
      links={[
        { href: '#make', label: 'What students make' },
        { href: '#igniters', label: '7 Igniters' },
        { href: '#cost', label: 'Cost' },
        { href: '#questions', label: 'Questions' },
      ]}
    />

    <main>
      <section class="hero" aria-labelledby="t">
        <div class="aside l">
          <figure>
            <Img src={portraitBrenda} alt="Brenda's Mission Portrait over a coral reef: core values optimistic, empathetic, resourceful and nurturing, her ID, mission and vision, and the line Broken crayons still color" width={240} />
            <figcaption>Brenda's Mission Portrait</figcaption>
          </figure>
        </div>
        <article class="sheet">
          <h1 id="t">Every first-year student leaves with a plan</h1>
          <p class="sub">Ignite Higher Ed fits orientation and your first-year seminar, led by your own faculty and staff. Public colleges use the <span style="white-space:nowrap">non-faith-based version</span>.</p>
          <ul class="facts">
            <li><i class="dia"></i>Faculty and staff certified in two 90-minute sessions</li>
            <li><i class="dia"></i>A first portrait in about 90 minutes</li>
            <li><i class="dia"></i>A written quote for your campus</li>
          </ul>
          <div class="acts">
            <a class="btn" href="#reply">Request a 20-minute call</a>
            <a class="link" href="#cost">See the first-year cost</a>
          </div>
          <p class="first-step">You can begin with <b>one session for your leaders</b>, {usd(PRICES.session)} for up to {PRICES.sessionLeaders}, then decide.</p>
          <p class="proofline in-sheet">Used in Ohio at <b>Hocking College</b>, and with leadership teams at <b>Northwest State</b>.</p>
          <Img
            class="plate"
            src={workbookCloseup}
            alt="A student writing in the Core Values Word Bank pages of the Mission Portrait workbook"
            widths={[480, 760, 1170]}
            sizes="(min-width: 980px) 648px, calc(100vw - 60px)"
            priority
          />
        </article>
        <div class="aside r">
          <figure>
            <p class="lede" style="font-size:17px">Every incoming freshman at <b>Hocking College</b> participates in Ignite Higher Ed.</p>
            <figcaption>Nelsonville, Ohio</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-sand voices" aria-label="What college leaders say" data-stage>
        <div class="quotes one">
          <figure class="q" data-rise>
            <blockquote>“Wildfire's curriculum gives students something most programs miss — real clarity on their purpose and a vision for their future.”</blockquote>
            <figcaption><b>Dr. Todd Hernandez</b>, President, Northwest State Community College</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-paper split make" id="make" aria-labelledby="make-h" data-stage>
        <div>
          <h2 id="make-h" data-rise>What each student makes</h2>
          <p class="lede" data-rise>A one-page Mission Portrait: their core values, a personal motto, their mission and their vision, set over an image they choose.</p>
          <p class="lede" data-rise>Then the 7 Igniters turn that page into a plan for the years ahead.</p>
          <figure class="side-fig" data-rise>
            <Img src={framework} alt="How a Mission Portrait is laid out: core values, an ID or slogan, mission, vision and a passage or quote, shown on an example portrait" widths={[360, 540, 720]} sizes="(min-width: 980px) 340px, 100vw" kind="graphic" />
            <figcaption>How a Mission Portrait is laid out (an adult's example)</figcaption>
          </figure>
        </div>
        <div class="stack">
          <figure class="real" data-rise>
            <Img src={portraitSarah} alt="Sarah's finished Mission Portrait over a field of daisies: core values family oriented, authentic, loyal and passionate, her ID, mission and vision, and the line There is no courage without vulnerability" widths={[480, 720, 960, 1280]} sizes="(min-width: 980px) 44vw, calc(100vw - 48px)" alpha />
            <figcaption>Sarah's Mission Portrait</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-field split igniters" id="igniters" aria-labelledby="ig-h" data-stage>
        <div>
          <h2 id="ig-h" data-rise>From purpose to a career plan</h2>
          <p class="lede" data-rise>The 7 Igniters is a simple, seven-step career-discovery process that starts from each student's own purpose.</p>
          <p class="lede" data-rise>The Mission Portrait helps students name who they are and what matters to them. The 7 Igniters connect that purpose with their strengths, dreams, assessment insights, possible career paths and practical next steps.</p>
          <p class="lede" data-rise><b>Each student leaves with a personal roadmap.</b></p>
          <p class="ai" data-rise><b>About the AI.</b> Two helpers in the app use AI, and both are optional. Career Discovery in step four suggests possible career paths from the student's dreams, gifts, assessments and interests, and the student chooses which to explore. A guide on each step suggests next steps from what the student types into it. Neither is sent the student's name or email, and a student can finish the roadmap without them.</p>
          <div class="try" data-rise>
            <h3>A sample for first-year experience or advising</h3>
            <p>Igniter 7 shows how the portrait and the seven steps lead to something a student can act on. Ask each student to:</p>
            <ol>
              <li>Pick one career or education option they are curious about</li>
              <li>Name one action they can take this week</li>
              <li>Set a date</li>
              <li>Name someone who can help</li>
            </ol>
            <p class="eg">For example, asking an advisor to help set up a job shadow.</p>
          </div>
          <p class="next-step" data-rise><a class="link" href={IGNITERS_SAMPLE} target="_blank" rel="noopener">See a sample student roadmap</a></p>
        </div>
        <figure data-rise>
          <a href={IGNITERS_SAMPLE} target="_blank" rel="noopener"><Img src={sampleRoadmap} alt="A sample 7 Igniters roadmap for Maya Thompson, a fictional high school student: her values, vision and mission, her one, three and ten-year dreams, her commitments, assessment takeaways, priorities, her team, her next steps and the career paths she chose to explore" widths={[360, 540, 720, 960, 1280]} sizes="(min-width: 980px) 44vw, calc(100vw - 48px)" kind="graphic" /></a>
          <figcaption>A sample student roadmap. Maya is a fictional student.</figcaption>
        </figure>
      </section>

      <section class="band on-sand cost" id="cost" aria-labelledby="cost-h" data-stage>
        <div>
          <h2 id="cost-h" data-rise>Your first year, and what it costs</h2>
          <p class="lede" data-rise>Three steps. Start with one cohort, such as every incoming freshman.</p>
          <ol class="steps">
            <li data-rise><i class="dia"></i><h3>Experience it first</h3><p>Your leaders make their own Mission Portraits in two hours, or four with Working Genius. You can stop there and decide.</p></li>
            <li data-rise><i class="dia"></i><h3>Equip your facilitators</h3><p>Choose the faculty and staff who will lead it. Two 90-minute sessions certify them in the Mission Portrait and the 7 Igniters. Lesson plans and materials are included.</p></li>
            <li data-rise><i class="dia"></i><h3>License your program</h3><p>An annual license, from a pilot cohort or one program up to campus-wide. Final pricing scales with enrollment.</p></li>
          </ol>
          <div class="planner" data-planner="he" data-rise>
            <h3>Price your campus</h3>
            <div class="ctl">
              <label for="p-session">Leadership session</label>
              <select id="p-session" data-select="session">
                <option value="mp" selected>2 hours, Mission Portrait</option>
                <option value="wg">4 hours, with Working Genius</option>
                <option value="none">Skip for now</option>
              </select>
            </div>
            <div class="ctl" data-when="session">
              <label id="ll">Leaders in the session<small>Up to {PRICES.sessionLeaders} included, then {usd(PRICES.extraPerson)} each</small></label>
              <div class="stepper" role="group" aria-labelledby="ll">
                <button type="button" data-key="leaders" data-step="-1" aria-label="One fewer leader">−</button>
                <output data-out="leaders">{L}</output>
                <button type="button" data-key="leaders" data-step="1" aria-label="One more leader">+</button>
              </div>
            </div>
            <div class="ctl">
              <label id="lf">Facilitators to certify<small>{usd(PRICES.certPerTrack)} a person, per track</small></label>
              <div class="stepper" role="group" aria-labelledby="lf">
                <button type="button" data-key="facilitators" data-step="-1" aria-label="One fewer facilitator">−</button>
                <output data-out="facilitators">{F}</output>
                <button type="button" data-key="facilitators" data-step="1" aria-label="One more facilitator">+</button>
              </div>
            </div>
            <label class="check"><input type="checkbox" checked data-check="mpTrack" /> Mission Portrait track</label>
            <label class="check"><input type="checkbox" checked data-check="igTrack" /> 7 Igniters track</label>
            <div class="ctl">
              <label for="p-license">Annual license</label>
              <select id="p-license" data-select="license">
                {PRICES.collegeLicense.map((t) => <option value={t.key} selected={t.key === LIC.key}>{t.label}</option>)}
              </select>
            </div>
            <p class="running" aria-hidden="true"><span>First year</span><strong data-v="running">{usd(total)}</strong></p>
          </div>
        </div>
        <div>
          <div class="receipt" data-rise>
            <p class="head">Ignite Higher Ed, year one</p>
            <p class="sub">Estimate for one campus. Final pricing scales with enrollment.</p>
            <div class="row" data-row="session"><span data-l="session">Leadership session, 2 hours, up to {PRICES.sessionLeaders} leaders</span><span data-v="session">{usd(session)}</span></div>
            <div class="row"><span data-l="cert">Certify {F} facilitators in both tracks, {usd(certCost(1))} each</span><span data-v="cert">{usd(cert)}</span></div>
            <div class="row"><span data-l="lic">Annual license: {LIC.label.toLowerCase()}</span><span data-v="lic">{usd(LIC.price)}</span></div>
            <div class="bar"></div>
            <div class="total"><strong data-v="total" aria-live="polite">{usd(total)}</strong><span>first year</span></div>
            <div class="next"><span>Each year after</span><span data-v="next">{usd(LIC.price)}</span></div>
            <a class="btn ink" href="#reply">Get this as a written quote</a>
          </div>
        </div>
      </section>

      <section class="band on-field proof" id="colleges" aria-labelledby="colleges-h" data-stage>
        <div class="split">
          <div>
            <h2 id="colleges-h" data-rise>How one college runs it</h2>
            <p class="lede" data-rise>Hocking College is a public college in Nelsonville, Ohio. Every incoming freshman at Hocking College participates in Ignite Higher Ed:</p>
            <ul class="model">
              <li data-rise><i class="dia"></i>First-year students take it in the Pathways course</li>
              <li data-rise><i class="dia"></i>Each student makes a Mission Portrait, then works through the 7 Igniters</li>
            </ul>
            <figure class="q" data-rise>
              <blockquote>“As the Executive Director of Student Engagement and Success at Hocking College, I have had the privilege of observing firsthand the profound impact of the “Mission Portrait” and “7 Igniters” program on our first-year students in the Pathways course. This initiative is truly transformative, going far beyond a conventional academic plan to deeply engage students in discovering their authentic selves and charting a course for enduring success during the first semester and beyond.”</blockquote>
              <figcaption><b>Terry Koons</b>, Executive Director of Student Engagement and Success, Hocking College</figcaption>
            </figure>
          </div>
          <div class="namecard" data-rise>
            <h3>Colleges using Ignite</h3>
            <ul>
              <li class="logo"><Img src={logoHocking} alt="" width={64} kind="graphic" alpha /><span><b>Hocking College</b><br />Every incoming freshman participates</span></li>
              <li class="logo"><Img src={logoNorthwest} alt="" width={64} kind="graphic" /><span><b>Northwest State Community College</b><br />Leadership teams and selected departments</span></li>
            </ul>
          </div>
        </div>
        <p class="next-step" data-rise>Want the same plan for your campus? <a class="btn" href="#reply">Request a 20-minute call</a></p>
      </section>

      <section class="band on-paper ask" id="questions" aria-labelledby="q-h" data-stage>
        <div>
          <h2 id="q-h" data-rise>Questions colleges ask first</h2>
          {faqs.map((f, i) => (
            <details data-rise open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <form class="card" id="reply" data-rise data-school-form data-program="Ignite Higher Ed" action="https://formsubmit.co/info@wildfireleadership.com" method="POST" aria-labelledby="reply-h">
          <h2 id="reply-h">Plan your first year</h2>
          <p class="s">A 20-minute call, then a written quote.</p>
          <p class="s" data-sent hidden><b>Thank you.</b> Your request reached us. We reply within 24 business hours.</p>
          <input type="hidden" name="_subject" value="Ignite Higher Ed inquiry" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_next" value="https://www.wildfireleadership.com/colleges/?sent=true#reply" />
          <input type="hidden" name="interest" value="Ignite Higher Ed" />
          <div class="fields">
            <label>Your name<input name="name" autocomplete="name" required /></label>
            <label>Your role
              <select name="role" required>
                <option value="" selected disabled>Choose one</option>
                <option>President or vice president</option><option>Dean of students</option><option>First-year experience</option><option>Career services</option><option>Faculty</option><option>Other</option>
              </select>
            </label>
            <label class="full">College or university<input name="college" autocomplete="organization" required data-org /></label>
            <label>Where you would start
              <select name="start" required>
                <option value="" selected disabled>Choose one</option>
                <option>Orientation</option><option>First-year seminar</option><option>Leadership session only</option><option>Not sure yet</option>
              </select>
            </label>
            <label>Email<input type="email" name="email" autocomplete="email" required /></label>
            <input type="hidden" name="estimate" value="" />
            <p class="est-line" data-v="estline"></p>
          </div>
          <button class="btn" type="submit">Request a 20-minute call</button>
          <p class="alt">Or email <a href="mailto:info@wildfireleadership.com">info@wildfireleadership.com</a>. We reply within 24 business hours.</p>
        </form>
      </section>
    </main>

    <IgniteAbout program="Ignite Higher Ed" other={{ href: '/schools/', label: 'Ignite Students, for K-12 schools' }} faithLine="Faith-based colleges: ask about the faith-based version." />
  </div>
  <IgniteScript />
</BaseLayout>
