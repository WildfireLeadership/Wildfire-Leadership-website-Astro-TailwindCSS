---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import { abs, provider } from '../data/site';

const path = '/facilitators/';
const course = (name: string, description: string) => ({ '@type': 'Course', name, description, provider });
const jsonLd = {
  '@type': 'Course',
  '@id': `${abs(path)}#course`,
  name: 'Wildfire Leadership Facilitator Certification',
  url: abs(path),
  description: 'A 90-minute Wildfire Leadership training workshop to become certified as a facilitator and share the tools and frameworks with others. Certified facilitators join a network of more than 70.',
  provider,
  educationalCredentialAwarded: 'Certified Wildfire Facilitator',
  hasPart: [
    course('Mission Portrait™ Certification', 'Guide individuals and groups through the Mission Portrait™ process.'),
    course('7 Igniters™ Certification', 'Coach individuals through stages that create a roadmap to live their Mission Portrait™ and accomplish their dreams.'),
    course('Assessment Certification', 'Lead individuals and teams through Working Genius, DISC, 5 Levels of Leadership, Ideal Team Player, and 5 Dysfunctions.'),
  ],
};
---

<BaseLayout
  title="Become a Certified Facilitator"
  description="Become a certified Wildfire facilitator in a 90-minute training workshop: Mission Portrait™, 7 Igniters™, and Assessment certification."
  breadcrumbs={[{ name: 'Certification', path }]}
  jsonLd={jsonLd}
>

  <!-- Force header-light for light hero -->
  <script>document.getElementById('site-header')?.classList.add('header-light');</script>

  <!-- ===== HERO ===== -->
  <PageHero
    variant="light"
    title='Become a Certified<br/><em>Wildfire Facilitator</em>'
    subtitle="Do you have a passion to help others uncover their purpose and unleash their potential?"
  />

  <!-- ===== INTRO — White bg ===== -->
  <section class="relative py-24 md:py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="max-w-3xl">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-6">Certification Programs</p>
        <p class="reveal reveal-d1 font-display text-3xl md:text-4xl lg:text-[2.75rem] text-charcoal leading-[1.25]">
          Enroll in a 90-minute Wildfire Leadership training workshop to become certified as a facilitator and share the impactful tools and frameworks with others.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CERTIFICATION CARDS: three plain cards, one action under them (no icon tiles, Will 2026-11-25) ===== -->
  <section class="relative py-24 md:py-32 bg-warm-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-3 gap-5 md:gap-6">

        <!-- Card 1: Mission Portrait™ -->
        <div class="reveal bg-white rounded-2xl border border-sand/50 p-8 md:p-10">
          <h3 class="font-display text-2xl md:text-3xl text-charcoal mb-4">Mission Portrait™ Certification</h3>
          <p class="text-base text-stone leading-relaxed">
            Guide individuals and groups through the Mission Portrait™ process. Join a network of Wildfire Facilitators for ongoing encouragement and professional development.
          </p>
        </div>

        <!-- Card 2: 7 Igniters™ -->
        <div class="reveal reveal-d1 bg-white rounded-2xl border border-sand/50 p-8 md:p-10">
          <h3 class="font-display text-2xl md:text-3xl text-charcoal mb-4">7 Igniters™ Certification</h3>
          <p class="text-base text-stone leading-relaxed">
            Gain tools to coach individuals through stages that help create a roadmap to live their Mission Portrait™ and accomplish their dreams.
          </p>
        </div>

        <!-- Card 3: Assessment -->
        <div class="reveal bg-white rounded-2xl border border-sand/50 p-8 md:p-10">
          <h3 class="font-display text-2xl md:text-3xl text-charcoal mb-4">Assessment Certification</h3>
          <p class="text-base text-stone leading-relaxed">
            As a certified Wildfire Leadership facilitator, you'll be equipped to lead individuals and teams through proven assessments including Working Genius, DISC, 5 Levels of Leadership, Ideal Team Player, and 5 Dysfunctions.
          </p>
        </div>

      </div>
      <div class="reveal mt-12 text-center">
        <a href="/contact?interest=facilitator" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full text-sm font-medium tracking-wide text-white bg-charcoal hover:bg-ember transition-colors duration-300">
          Ask about certification
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== FACILITATOR NETWORK — Cream bg ===== -->
  <section class="relative py-24 md:py-32 bg-cream">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-6">Our Network</p>
        <h2 class="reveal reveal-d1 font-display text-3xl md:text-4xl lg:text-5xl text-charcoal leading-[1.1]">
          A growing community of <em>facilitators.</em>
        </h2>
        <p class="reveal reveal-d2 mt-8 text-base md:text-lg text-stone leading-relaxed">
          Join a growing network of more than 70 certified facilitators, serving leaders and teams across business, education, and non-profit sectors.
        </p>
        <div class="reveal reveal-d3 mt-10">
          <a href="/contact?interest=facilitator" class="group inline-flex items-center gap-3 text-sm font-medium tracking-wide text-charcoal border-b border-charcoal/30 pb-1 hover:border-ember hover:text-ember transition-colors duration-400">
            Join the network
            <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="facilitator-toolkit" class="py-20 md:py-28 bg-warm-white scroll-mt-24" aria-labelledby="toolkit-title">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ember mb-4">In development · Not yet available</p>
        <h2 id="toolkit-title" class="font-display text-4xl md:text-5xl mb-6">You bring the people.<br/><em>We help you lead.</em></h2>
        <p class="text-lg text-charcoal/80 leading-relaxed mb-6">The planned 7 Igniters™ Facilitator Toolkit is a simple system for guiding your own group from purpose to action. Open the guide, follow the session flow, and help each person take a meaningful next step.</p>
        <p class="font-display text-5xl mb-3">$10<span class="font-sans text-lg">/month</span></p>
        <p class="text-base text-charcoal/80 mb-7">Proposed subscription price. We’re gathering interest as we develop the toolkit. No payment or subscription begins when you inquire.</p>
        <a href="/contact?interest=7-igniters-toolkit" class="inline-flex px-7 py-4 rounded-full bg-charcoal text-white hover:bg-ember transition-colors">Ask about the $10/month toolkit</a>
      </div>
      <div class="bg-white rounded-2xl border border-sand p-7 md:p-10">
        <h3 class="font-display text-3xl mb-6">What we’re planning</h3>
        <ul class="space-y-4 text-base text-charcoal/80 list-disc pl-5">
          <li><strong>Facilitator guides:</strong> preparation notes and clear instructions for each Igniter.</li>
          <li><strong>Session flow:</strong> a repeatable sequence for opening, exploring, discussing, and choosing an action.</li>
          <li><strong>Discussion questions:</strong> prompts that help people connect the framework to real life.</li>
          <li><strong>Downloadable tools:</strong> activity sheets, action planners, and progress check-ins.</li>
          <li><strong>Ongoing value:</strong> fresh discussion prompts, new application activities, and updated guides to support returning groups.</li>
        </ul>
        <p class="mt-7 text-base text-charcoal/80">This would support self-facilitation; it would not award Wildfire facilitator certification. Final contents, update schedule, participant-material requirements, and group-use permissions will be confirmed before enrollment opens.</p>
      </div>
    </div>
  </section>

  <!-- ===== CTA CLOSER ===== -->
  <CallToAction
    title='Start your<br/><em class="ember-gradient">certification.</em>'
    description="Take the first step toward becoming a certified Wildfire facilitator and impacting the lives of others."
    buttonText="Apply for Certification"
    buttonHref="/contact?interest=facilitator"
  />

</BaseLayout>
