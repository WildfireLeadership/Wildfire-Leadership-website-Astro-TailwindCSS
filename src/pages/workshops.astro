---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import { abs, provider, INVEST_URL } from '../data/site';

const path = '/workshops/';
const offer = (name: string, description: string, extra: Record<string, unknown> = {}) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name, description, provider, ...extra },
});
const jsonLd = {
  '@type': 'OfferCatalog',
  '@id': `${abs(path)}#catalog`,
  name: 'Workshops & Experiences',
  url: abs(path),
  itemListElement: [
    offer('Leadership Development Workshops', 'Hands-on sessions for any leadership team: Working Genius, The Advantage, Mission Portrait™, 5 Levels of Leadership, Mastering Crucial Conversations, Extreme Ownership, 5 Dysfunctions of a Team, 7 Igniters™ Roadmap, and DISC Leadership Essentials.'),
    offer('Individual Mission Portrait™ + Coaching', 'A 60-minute, one-on-one session with a Certified Facilitator who coaches you through the Mission Portrait™ process.'),
    offer('Couples Mission Portrait™ + Coaching', 'A 90-minute session to define your individual and shared purpose as a couple.'),
    offer('Family Mission Portrait™ Workshop', 'A 2-hour workshop to discover shared family values, dreams, and purpose.'),
    offer('INVEST Marriage', 'An 8-week, Christ-centered marriage journey created by Bill and Stephanie Lammers.', { url: INVEST_URL }),
    offer('Keynote Speaking', 'Bill and Stephanie Lammers speak across business, education, and faith communities.'),
  ],
};
---

<BaseLayout
  title="Workshops & Keynote Speaking"
  description="Leadership workshops, Mission Portrait™ coaching for individuals and couples, Family Mission Portrait™ workshops, INVEST Marriage, and keynote speaking."
  breadcrumbs={[{ name: 'Workshops & Experiences', path }]}
  jsonLd={jsonLd}
>

  <!-- Force header-light for light hero -->
  <script>document.getElementById('site-header')?.classList.add('header-light');</script>

  <!-- ===== HERO ===== -->
  <PageHero
    variant="light"
    title='Workshops &<br/><em>Experiences</em>'
    subtitle="Transform your team, marriage, or personal journey through our hands-on workshop experiences."
  >
    <p class="workshops-keynote reveal reveal-d2 mt-5 text-base md:text-lg text-charcoal/80 max-w-2xl leading-relaxed">
      For couples and families, we offer the Couples Mission Portrait™ + Coaching, the Family Mission Portrait™ Workshop, and <a href={INVEST_URL}>INVEST Marriage</a>, a Christ-centered marriage journey.
      Bill and Stephanie Lammers are available for <a href="#speaking">keynote speaking</a> engagements across business, education, and faith communities.
    </p>
  </PageHero>

  <!-- ===== WORKSHOP LISTINGS ===== -->
  <section class="relative py-24 md:py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="max-w-3xl mb-16">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-6">Our Workshops</p>
        <h2 class="reveal reveal-d1 font-display text-3xl md:text-4xl lg:text-5xl text-charcoal leading-[1.1]">
          Hands-on experiences that <em>transform.</em>
        </h2>
      </div>

      <!-- ── LEADERSHIP DEVELOPMENT ── -->
      <div class="mb-16">
        <h2 class="reveal flex items-center gap-4 mb-6 text-[11px] font-semibold uppercase tracking-[0.25em] text-stone"><span class="shrink-0">Leadership Development</span><span class="h-px flex-1 bg-sand" aria-hidden="true"></span></h2>

        <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <h3 class="font-display text-2xl md:text-3xl text-charcoal">Leadership Development Workshops</h3>
          </div>
          <p class="text-base text-stone leading-relaxed mb-6">
            Hands-on sessions available for any leadership team — across business, education, faith, and community organizations. Each workshop equips your team with practical tools for collaboration, accountability, and trust.
          </p>
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2 mb-8">
            {[
              "Working Genius Overview",
              "Working Genius Deep Dive",
              "The Advantage — Team Cohesion & Health",
              "Mission Portrait™",
              "5 Levels of Leadership",
              "Mastering Crucial Conversations",
              "Extreme Ownership",
              "5 Dysfunctions of a Team",
              "7 Igniters™ Roadmap",
              "DISC Leadership Essentials",
            ].map((session) => (
              <p class="text-sm text-stone flex items-start gap-2">
                <span class="text-ember mt-0.5 flex-shrink-0">&bull;</span>
                {session}
              </p>
            ))}
          </div>
          <div class="mb-6 divide-y divide-sand/70 border-y border-sand/70">
            <div class="py-4">
              <p class="text-sm text-charcoal"><strong class="text-ember">Recommended combo:</strong> Working Genius + Mission Portrait™ — a team building series that uncovers strengths, builds alignment, and creates high-performing teams.</p>
            </div>
            <div class="py-4">
              <p class="text-sm text-charcoal"><strong class="text-ember">Go deeper:</strong> Mission Portrait™ + 7 Igniters™ — craft a personalized Mission Portrait™, then walk through the 7 Igniters™ framework to turn clarity into a concrete action plan.</p>
            </div>
            <div class="py-4">
              <p class="text-sm text-charcoal"><strong class="text-ember">Elevate your team:</strong> The Advantage — a multi-session workshop built on Patrick Lencioni's framework for organizational health. Build vulnerability-based trust, productive conflict, commitment, accountability, and collective results through hands-on exercises and team discovery.</p>
            </div>
          </div>
          <p class="text-xs text-stone/60 italic mb-6">Not sure which workshops fit your team? We'll recommend the right combination during your consultation.</p>
          <a href="/contact?interest=leadership" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
            Ask about leadership workshops
            <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- ── PERSONAL & INDIVIDUAL ── -->
      <div class="mb-16">
        <h2 class="reveal flex items-center gap-4 mb-6 text-[11px] font-semibold uppercase tracking-[0.25em] text-stone"><span class="shrink-0">Personal & Individual</span><span class="h-px flex-1 bg-sand" aria-hidden="true"></span></h2>

        <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <h3 class="font-display text-2xl md:text-3xl text-charcoal">Individual Mission Portrait™ + Coaching</h3>
            <span class="shrink-0 inline-flex items-center px-4 py-1.5 rounded-full bg-cream text-[13px] font-medium text-stone">60 min</span>
          </div>
          <p class="text-base text-stone leading-relaxed mb-6">
            A one-on-one session with a Certified Facilitator who coaches you through the Mission Portrait™ process. Leave with a personalized visual guide to your purpose, values, and vision.
          </p>
          <a href="/contact?interest=coaching" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
            Book a 1-on-1 session
            <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- ── MARRIAGE & FAMILY ── -->
      <div class="mb-16">
        <h2 class="reveal flex items-center gap-4 mb-6 text-[11px] font-semibold uppercase tracking-[0.25em] text-stone"><span class="shrink-0">Marriage & Family</span><span class="h-px flex-1 bg-sand" aria-hidden="true"></span></h2>

        <div class="space-y-5">
          <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
              <h3 class="font-display text-2xl md:text-3xl text-charcoal">Couples Mission Portrait™ + Coaching</h3>
              <span class="shrink-0 inline-flex items-center px-4 py-1.5 rounded-full bg-cream text-[13px] font-medium text-stone">90 min</span>
            </div>
            <p class="text-base text-stone leading-relaxed mb-6">
              Define your individual and shared purpose as a couple. Leave with personalized Mission Portraits and a foundation for dreaming together.
            </p>
            <a href="/contact?interest=coaching" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
              Book a couples session
              <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
              <h3 class="font-display text-2xl md:text-3xl text-charcoal">Family Mission Portrait™ Workshop</h3>
              <span class="shrink-0 inline-flex items-center px-4 py-1.5 rounded-full bg-cream text-[13px] font-medium text-stone">2 hours</span>
            </div>
            <p class="text-base text-stone leading-relaxed mb-6">
              Bring your family together to discover shared values, dreams, and purpose. Leave with a personalized Family Mission Portrait™ — a visual legacy you can live by every day.
            </p>
            <a href="/family-mission-portrait" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
              See the family workshop
              <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
              <h3 class="font-display text-2xl md:text-3xl text-charcoal">INVEST Marriage</h3>
              <span class="shrink-0 inline-flex items-center px-4 py-1.5 rounded-full bg-cream text-[13px] font-medium text-stone">8 weeks</span>
            </div>
            <p class="text-base text-stone leading-relaxed mb-6">
              <em class="text-charcoal font-medium not-italic">Know who you are. Know who you married. Know what you are building together.</em> A Christ-centered marriage journey created by Bill and Stephanie Lammers.
            </p>
            <a href="https://invest.wildfireleadership.com" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
              Visit INVEST Marriage
              <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ── SPEAKING ── -->
      <div id="speaking" class="scroll-mt-24">
        <h2 class="reveal flex items-center gap-4 mb-6 text-[11px] font-semibold uppercase tracking-[0.25em] text-stone"><span class="shrink-0">Speaking</span><span class="h-px flex-1 bg-sand" aria-hidden="true"></span></h2>

        <div class="reveal bg-white rounded-xl border border-sand/50 p-8 md:p-10">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <h3 class="font-display text-2xl md:text-3xl text-charcoal">Keynote Speaking</h3>
          </div>
          <p class="text-base text-stone leading-relaxed mb-6">
            Bill and Stephanie Lammers are available for keynote speaking engagements across business, education, and faith communities — sharing the frameworks, tools, and stories behind Wildfire Leadership.
          </p>
          <a href="/contact?interest=speaking" class="group inline-flex items-center gap-2 text-sm font-medium text-charcoal hover:text-ember transition-colors duration-400">
            Ask about a keynote
            <svg class="w-3.5 h-3.5 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA CLOSER ===== -->
  <CallToAction
    title='Book your<br/><em class="ember-gradient">workshop.</em>'
    description="Ready to invest in your team, your family, or yourself? Let's find the right workshop for you."
    buttonText="Schedule a Consultation"
  />

</BaseLayout>

<style>
  .workshops-keynote a {
    color: var(--color-ember);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .workshops-keynote a:hover {
    color: var(--color-charcoal);
  }
</style>
