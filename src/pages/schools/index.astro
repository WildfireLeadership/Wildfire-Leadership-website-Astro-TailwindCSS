---
/**
 * Ignite Students for K-12 schools. Replaces /education/k-12 (redirected in vercel.json).
 * Built from the overnight audit concept, 17 November 2026, then Bill's notes of the same
 * evening: what it is, the non-faith-based version public schools use, who teaches it, the
 * first step and its price, and one button, all in the first screen. Verified educator
 * quotes right under it. The 7 Igniters gets its own section. Only the first step is
 * priced here; certification and the license are quoted per school. Nothing unconfirmed
 * is shown: no outcome figures or student-data answers until Wildfire supplies them.
 * Bill's notes of 18 November: Northeastern ran it at the high school only, from ninth
 * grade, with two teachers, and the case study describes the senior capstone (Alex
 * Nafziger confirmed this to Bill on 11 May); Alex's quote is the K-12 mailer's, credited
 * as principal during the implementation; Mrs. Profera is Teacher, Tinora High School.
 * The 7 Igniters section shows the General edition's fictional sample roadmap (rendered
 * from 7igniters.com/overview, served as a static image) and Bill's Igniter 7 exercise.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import IgniteTop from '../../components/ignite/IgniteTop.astro';
import IgniteAbout from '../../components/ignite/IgniteAbout.astro';
import IgniteScript from '../../components/ignite/IgniteScript.astro';
import IgniteClips, { type Clip } from '../../components/ignite/IgniteClips.astro';
import { abs, faqPage, provider, type Faq } from '../../data/site';
import { IGNITERS_SAMPLE } from '../../data/ignite';
import '../../styles/ignite.css';
import educationStudents from '../../assets/images/education-students.jpg';
import framework from '../../assets/images/mission-portrait-framework.png';
import maysaClip from '../../assets/images/maysa-testimonial.jpg';
import josiahClip from '../../assets/images/josiah-testimonial.jpg';
import studentsClip from '../../assets/images/students-share-impact.jpg';
import workshop from '../../assets/images/higher-ed-workshop.jpg';
import lifestyle from '../../assets/images/lifestyle.jpg';
// Real portraits already on the live homepage; Will OK'd showing them here, 2026-11-17.
// Both have no faith content (Zeb's and Ryan's do), so they suit a public-school page.
import portraitBrenda from '../../assets/images/portrait-coleen-full.png';
import portraitSarah from '../../assets/images/portrait-sarah-full.png';
import sampleRoadmap from '../../assets/images/7-igniters-sample-roadmap.png';
import logoNortheastern from '../../assets/images/school-logo-3.png';
import logoDefiance from '../../assets/images/school-logo-5.png';
import logoAyersville from '../../assets/images/school-logo-6.png';
import logoIndianLake from '../../assets/images/school-logo-7.png';
import logoNapoleon from '../../assets/images/school-logo-napoleon.gif';
import logoPatrickHenry from '../../assets/images/school-logo-patrick-henry.png';
import logoAllenEast from '../../assets/images/school-logo-allen-east.jpg';

const path = '/schools/';

const schools = [
  { logo: logoNortheastern, name: 'Northeastern Local Schools', note: 'High school: ninth grade through a senior capstone' },
  { logo: logoDefiance, name: 'Defiance City Schools' },
  { logo: logoNapoleon, name: 'Napoleon Area Schools', alpha: true },
  { logo: logoPatrickHenry, name: 'Patrick Henry Local Schools', alpha: true },
  { logo: logoAyersville, name: 'Ayersville Local Schools' },
  { logo: logoIndianLake, name: 'Indian Lake High School' },
  { logo: logoAllenEast, name: 'Allen East Schools' },
];

// Student clips (Bill, 26 November 2026), as on the old K-12 page. First names and program only.
const students: Clip[] = [
  { vimeo: '1163802453', title: 'Maysa', program: 'Ignite Students (K-12)', play: "Play Maysa's clip", length: '1:04', thumb: maysaClip, alt: 'Maysa, smiling, in her room' },
  { vimeo: '1167969928', title: 'Josiah', program: 'Ignite Students (K-12)', play: "Play Josiah's clip", length: '0:43', thumb: josiahClip, alt: 'Josiah, seated, in a cap and vest', focus: '50% 30%' },
  { vimeo: '1179978600', title: 'Students share the impact', program: 'Ignite Students (K-12)', play: "Play the students' clip", length: '0:23', thumb: studentsClip, alt: 'A student speaking, with the caption Before Ignite, I felt', focus: '50% 30%' },
];

// The two Mission Portrait videos, on both pages (they were on the old K-12 and Higher Ed pages).
const mpVideos: Clip[] = [
  { vimeo: '1166391178', title: "What's a Mission Portrait?", program: 'Ignite Students and Ignite Higher Ed', play: 'Play the video', length: '3:18', thumb: workshop, alt: 'Students at long tables writing on Mission Portrait worksheets', focus: '50% 40%' },
  { vimeo: '1166391250', title: 'How the Mission Portrait works', program: 'Ignite Students and Ignite Higher Ed', play: 'Play the video', length: '1:40', thumb: lifestyle, alt: 'A Mission Portrait worksheet with handwritten notes under Top 4 core values' },
];

const faqs: Faq[] = [
  {
    q: 'Which version would our school use?',
    a: 'Public schools use the non-faith-based version. Churches and faith-based schools use the faith-based version.',
  },
  {
    q: 'What grades is it for?',
    a: 'Northeastern starts it in ninth grade and comes back to it in a senior capstone. It can be adapted for other middle and high school grades, and for elementary.',
  },
  {
    q: 'Where does it fit in the schedule?',
    a: 'Advisory, a senior capstone, or career-readiness time. The ready-to-play video option needs little teacher prep.',
  },
  {
    q: 'How do teachers get certified?',
    a: 'Two 90-minute sessions certify your teachers in the Mission Portrait and the 7 Igniters. They leave with lesson plans and materials.',
  },
  {
    q: 'Can we start small?',
    a: 'Yes. Begin with the leadership session, decide afterward, and add teachers and classes when you are ready.',
  },
];

const jsonLd = [
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: 'Ignite Students',
    serviceType: 'Purpose and career-planning course for K-12 schools',
    url: abs(path),
    description:
      'A purpose and career-planning course that a school’s own teachers lead, using the Mission Portrait™ and the 7 Igniters™. Public schools use the non-faith-based version. Teachers are certified in two 90-minute sessions.',
    provider,
    audience: { '@type': 'EducationalAudience', educationalRole: 'administrator' },
  },
  faqPage(path, faqs),
];
---

<BaseLayout
  title="Ignite Students for K-12 schools"
  description="Ignite Students is a purpose and career-planning course your own teachers lead, with a non-faith-based version for public schools. See where to start and request a 20-minute call."
  breadcrumbs={[{ name: 'Schools', path }]}
  jsonLd={jsonLd}
  siteHeader={false}
  familyLinks={false}
>
  <div class="ig">
    <IgniteTop
      program="Ignite Students"
      links={[
        { href: '#make', label: 'What students make' },
        { href: '#igniters', label: '7 Igniters' },
        { href: '#start', label: 'Where to start' },
        { href: '#questions', label: 'Questions' },
      ]}
    />

    <main>
      <section class="hero" aria-labelledby="t">
        <div class="aside l">
          <figure>
            <Img src={portraitBrenda} alt="Brenda's Mission Portrait over a coral reef: core values optimistic, empathetic, resourceful and nurturing, her ID, mission and vision, and the line Broken crayons still color" width={240} />
            <figcaption>Brenda's Mission Portrait</figcaption>
          </figure>
        </div>
        <article class="sheet">
          <h1 id="t">Every student leaves with a plan</h1>
          <p class="sub">Ignite Students is a purpose and career-planning course your own teachers lead. Public schools use the <span style="white-space:nowrap">non-faith-based version</span>.</p>
          <ul class="facts">
            <li><i class="dia"></i>Teachers certified in two 90-minute sessions</li>
            <li><i class="dia"></i>Fits advisory or a senior capstone</li>
            <li><i class="dia"></i>Typical timeline: six to eight weeks</li>
          </ul>
          <div class="acts">
            <a class="btn" href="#reply">Request a 20-minute call</a>
          </div>
          <p class="proofline in-sheet">Used in Ohio by <b>Northeastern Local</b>, <b>Defiance City</b>, <b>Napoleon Area</b>, <b>Patrick Henry Local</b> and other districts.</p>
          <Img
            class="plate"
            src={educationStudents}
            alt="A student writing in the Ignite Students binder at a classroom desk, beside a Chromebook"
            widths={[480, 760, 1140, 1520]}
            sizes="(min-width: 980px) 648px, calc(100vw - 60px)"
            priority
          />
        </article>
        <div class="aside r">
          <figure>
            <p class="lede" style="font-size:17px">At <b>Northeastern Local Schools</b>, two teachers lead it at the high school, from ninth grade to a senior capstone.</p>
            <figcaption>Defiance County, Ohio</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-sand voices" aria-label="What educators say" data-stage>
        <div class="quotes">
          <figure class="q" data-rise>
            <blockquote>“A Mission Portrait can be completed in as little as 90 minutes if you choose — and every student walks away with a digital asset they can use immediately.”</blockquote>
            <figcaption><b>Alex Nafziger</b>, Principal at Northeastern during the implementation</figcaption>
          </figure>
          <figure class="q" data-rise>
            <blockquote>“As a teacher, I have been able to watch this program transform students’ mindsets and build their confidence in who they are as people and how they hope to succeed in their lives.”</blockquote>
            <figcaption><b>Mrs. Profera</b>, Teacher, Tinora High School</figcaption>
          </figure>
        </div>
      </section>

      <IgniteClips lede="Short clips in their own words, then the Mission Portrait in two videos." heading="Hear it from students" students={students} videos={mpVideos} />

      <section class="band on-paper split make" id="make" aria-labelledby="make-h" data-stage>
        <div>
          <h2 id="make-h" data-rise>What each student makes</h2>
          <p class="lede" data-rise>A one-page Mission Portrait: their core values, a personal motto, their mission and their vision, set over an image they choose.</p>
          <p class="lede" data-rise>Then the 7 Igniters turn that page into a plan, one step at a time.</p>
          <figure class="side-fig" data-rise>
            <Img src={framework} alt="How a Mission Portrait is laid out: core values, an ID or slogan, mission, vision and a passage or quote, shown on an example portrait" widths={[360, 540, 720]} sizes="(min-width: 980px) 340px, 100vw" kind="graphic" />
            <figcaption>How a Mission Portrait is laid out (an adult's example)</figcaption>
          </figure>
        </div>
        <div class="stack">
          <figure class="real" data-rise>
            <Img src={portraitSarah} alt="Sarah's finished Mission Portrait over a field of daisies: core values family oriented, authentic, loyal and passionate, her ID, mission and vision, and the line There is no courage without vulnerability" widths={[480, 720, 960, 1280]} sizes="(min-width: 980px) 44vw, calc(100vw - 48px)" alpha />
            <figcaption>Sarah's Mission Portrait</figcaption>
          </figure>
        </div>
      </section>

      <section class="band on-field split igniters" id="igniters" aria-labelledby="ig-h" data-stage>
        <div>
          <h2 id="ig-h" data-rise>From purpose to a career plan</h2>
          <p class="lede" data-rise>The 7 Igniters is a simple, seven-step career-discovery process that starts from each student's own purpose.</p>
          <p class="lede" data-rise>The Mission Portrait helps students name who they are and what matters to them. The 7 Igniters connect that purpose with their strengths, dreams, assessment insights, possible career paths and practical next steps.</p>
          <p class="lede" data-rise><b>Each student leaves with a personal roadmap.</b></p>
          <p class="ai" data-rise><b>About the AI.</b> Two helpers in the app use AI, and both are optional. Career Discovery in step four suggests possible career paths from the student's dreams, gifts, assessments and interests, and the student chooses which to explore. A guide on each step suggests next steps from what the student types into it. Neither is sent the student's name or email, and a student can finish the roadmap without them.</p>
          <div class="try" data-rise>
            <h3>A sample for advisory or a senior capstone</h3>
            <p>Igniter 7 shows how the portrait and the seven steps lead to something a student can act on. Ask each student to:</p>
            <ol>
              <li>Pick one career or education option they are curious about</li>
              <li>Name one action they can take this week</li>
              <li>Set a date</li>
              <li>Name someone who can help</li>
            </ol>
            <p class="eg">For example, asking a counselor to help set up a job shadow.</p>
          </div>
          <p class="next-step" data-rise><a class="link" href={IGNITERS_SAMPLE} target="_blank" rel="noopener">See a sample student roadmap</a></p>
        </div>
        <figure data-rise>
          <a href={IGNITERS_SAMPLE} target="_blank" rel="noopener"><Img src={sampleRoadmap} alt="A sample 7 Igniters roadmap for Maya Thompson, a fictional high school student: her values, vision and mission, her one, three and ten-year dreams, her commitments, assessment takeaways, priorities, her team, her next steps and the career paths she chose to explore" widths={[360, 540, 720, 960, 1280]} sizes="(min-width: 980px) 44vw, calc(100vw - 48px)" kind="graphic" /></a>
          <figcaption>A sample student roadmap. Maya is a fictional student.</figcaption>
        </figure>
      </section>

      <section class="band on-sand start" id="start" aria-labelledby="start-h" data-stage>
        <h2 id="start-h" data-rise>Where to start</h2>
        <p class="lede" data-rise>Begin with one session for your leaders, then decide. We'll send our menu of services.</p>
        <p class="next-step" data-rise><a class="btn ink" href="/contact?interest=ignite-k12">Request pricing for your school</a></p>
      </section>

      <section class="band on-field proof" id="schools" aria-labelledby="schools-h" data-stage>
        <div class="split">
          <div>
            <h2 id="schools-h" data-rise>How one high school runs it</h2>
            <p class="lede" data-rise>Northeastern Local Schools in Defiance County, Ohio, runs Ignite at its high school:</p>
            <ul class="model">
              <li data-rise><i class="dia"></i>Two teachers certified as facilitators</li>
              <li data-rise><i class="dia"></i>Students start in ninth grade</li>
              <li data-rise><i class="dia"></i>Seniors come back to it in a capstone</li>
            </ul>
          </div>
          <div class="namecard" data-rise>
            <h3>Ohio schools using Ignite</h3>
            <ul>
              {schools.map((s) => (
                <li class="logo">
                  <Img src={s.logo} alt="" width={64} kind="graphic" alpha={s.alpha} />
                  <span><b>{s.name}</b>{s.note && <><br />{s.note}</>}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="next-step" data-rise>Want the same plan for your school? <a class="btn" href="#reply">Request a 20-minute call</a></p>
      </section>

      <section class="band on-paper ask" id="questions" aria-labelledby="q-h" data-stage>
        <div>
          <h2 id="q-h" data-rise>Questions schools ask first</h2>
          {faqs.map((f, i) => (
            <details data-rise open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <form class="card" id="reply" data-rise data-school-form data-program="Ignite Students (K-12)" action="https://formsubmit.co/info@wildfireleadership.com" method="POST" aria-labelledby="reply-h">
          <h2 id="reply-h">Plan your first year</h2>
          <p class="s">A 20-minute call, then a written quote.</p>
          <p class="s" data-sent hidden><b>Thank you.</b> Your request reached us. We reply within 24 business hours.</p>
          <input type="hidden" name="_subject" value="Ignite Students (K-12) inquiry" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_next" value="https://www.wildfireleadership.com/schools/?sent=true#reply" />
          <input type="hidden" name="interest" value="Ignite Students (K-12)" />
          <div class="fields">
            <label>Your name<input name="name" autocomplete="name" required /></label>
            <label>Your role
              <select name="role" required>
                <option value="" selected disabled>Choose one</option>
                <option>Superintendent</option><option>Principal</option><option>Counselor or career advisor</option><option>Teacher</option><option>Other</option>
              </select>
            </label>
            <label class="full">School or district<input name="school" autocomplete="organization" required data-org /></label>
            <label>Where you would start
              <select name="start" required>
                <option value="" selected disabled>Choose one</option>
                <option>Ninth grade</option><option>Advisory</option><option>Senior capstone</option><option>Leadership session only</option><option>Not sure yet</option>
              </select>
            </label>
            <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          </div>
          <button class="btn" type="submit">Request a 20-minute call</button>
          <p class="alt">Or email <a href="mailto:info@wildfireleadership.com">info@wildfireleadership.com</a>. We reply within 24 business hours.</p>
        </form>
      </section>
    </main>

    <IgniteAbout program="Ignite Students" other={{ href: '/colleges/', label: 'Ignite Higher Ed, for colleges' }} />
  </div>
  <IgniteScript />
</BaseLayout>
