---
import LeadershipJourney from '../components/LeadershipJourney.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCounter from '../components/StatCounter.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CallToAction from '../components/CallToAction.astro';
import MapSection from '../components/MapSection.astro';
import PortraitLightbox from '../components/PortraitLightbox.astro';
import Img from '../components/Img.astro';
import { abs, ids, provider } from '../data/site';
import { HERO_WIDTHS, coverSizes, heroSizes } from '../lib/images';
import heroMain from '../assets/images/hero-main.jpg';
import missionPortraitGraphic from '../assets/images/mission-portrait-graphic.png';
import sevenIgnitersGraphic from '../assets/images/7-igniters-graphic.jpg';
import portraitColeen from '../assets/images/portrait-coleen-full.png';
import portraitZeb from '../assets/images/portrait-zeb-full.png';
import portraitSarah from '../assets/images/portrait-sarah-full.png';
import portraitRyan from '../assets/images/portrait-ryan-full.png';
import businessHero from '../assets/images/business-hero.jpg';
import higherEdWorkshop from '../assets/images/higher-ed-workshop.jpg';
import faithWorkshop from '../assets/images/faith-workshop.jpg';
import lifestyle from '../assets/images/lifestyle.jpg';
import businessWorkshopGroup from '../assets/images/business-workshop-group.jpg';
import businessWorkshopClose from '../assets/images/business-workshop-close.jpg';
import familyWorkshop from '../assets/images/faith-family-workshop.jpg';
import educationStudents from '../assets/images/education-students.jpg';
import studentsMissionPortraits from '../assets/images/students-mission-portraits.jpg';

const service = (name: string, path: string, description: string) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name, description, url: abs(path), provider },
});

// Merges into the Organization node: what Wildfire offers, as this page states it.
const jsonLd = {
  '@id': ids.organization,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Wildfire Leadership tools and services',
    itemListElement: [
      service('Mission Portrait™', '/mission-portrait/', 'A customized visual daily reminder of your personal mission and purpose. $35 self-guided, or $299 with a Certified Facilitator.'),
      service('The 7 Igniters™', '/7-igniters/', 'A proven seven-step framework from purpose to potential.'),
      service('Leadership coaching', '/leadership-coaching/', 'Personalized coaching for individuals and teams.'),
      service('Workshops', '/workshops/', 'Hands-on leadership, team, marriage, and family workshops.'),
      service('Keynote speaking', '/workshops/', 'Keynotes by Bill and Stephanie Lammers.'),
      service('Facilitator certification', '/facilitators/', 'Training to become a certified Wildfire facilitator.'),
    ],
  },
};
---

<BaseLayout
  title="Uncover Purpose. Unleash Potential"
  fullTitle="Wildfire Leadership | Leadership Coaching & Mission Portrait™"
  description="Wildfire Leadership, founded by Bill and Stephanie Lammers and based in Charleston, South Carolina, offers leadership coaching and the Mission Portrait™."
  jsonLd={jsonLd}
  heroImage={heroMain}
  heroVariant="home"
>

  <!-- ===== HERO — Cinematic full-bleed (Porsche-style immersive) ===== -->
  <section class="relative min-h-[760px] md:min-h-[900px] flex items-end overflow-hidden pt-32">
    <div class="absolute inset-0">
      <Img
        src={heroMain}
        alt="Wildfire Leadership"
        widths={HERO_WIDTHS}
        sizes={heroSizes(heroMain, 'home')}
        priority
        class="absolute inset-0 w-full h-full object-cover"
        style="animation: heroZoom 20s ease-in-out infinite alternate;"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/40 to-charcoal-deep/5"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal-deep/50 via-transparent to-transparent"></div>
    </div>

    <div class="relative max-w-[1400px] mx-auto px-5 md:px-8 pb-20 md:pb-28 w-full">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] leading-relaxed text-white/70 mb-6">Wildfire Leadership<span class="hidden sm:inline"> · </span><span class="block sm:inline">Charleston, South Carolina</span></p>
      <h1 class="font-display text-[clamp(3rem,10vw,8.5rem)] leading-[0.9] tracking-tight text-white">
        <span class="block reveal">Uncover</span>
        <span class="block reveal reveal-d1"><em class="ember-gradient">Purpose.</em></span>
        <span class="block reveal reveal-d2">Unleash</span>
        <span class="block reveal reveal-d3"><em class="ember-gradient">Potential.</em></span>
      </h1>
      <p class="reveal reveal-d4 mt-6 text-base md:text-lg text-white/70 max-w-xl leading-relaxed">
        Founded by Bill and Stephanie Lammers, Wildfire Leadership offers leadership coaching, workshops, and practical, visual tools for individuals, families, and organizations. Start with your Mission Portrait™. Turn your purpose into a plan with the 7 Igniters™. Take your next step with confidence.
      </p>
      <div class="flex flex-wrap gap-4 mt-7">
        <a href="/mission-portrait#pricing" class="px-7 py-4 rounded-full bg-ember text-white font-medium hover:bg-charcoal transition-colors">Step 1: Create your Mission Portrait</a>
        <a href="#start-here" class="px-7 py-4 rounded-full border border-white/60 text-white font-medium hover:bg-white/10 transition-colors">See your next steps</a>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center reveal reveal-d5">
      <svg class="w-5 h-5 text-white/40 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <LeadershipJourney />

  <!-- ===== PROBLEM STAT ===== -->
  <section class="relative py-16 md:py-20 bg-charcoal">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="reveal flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6 text-center md:text-left">
        <span class="font-display text-7xl md:text-8xl lg:text-9xl text-ember leading-none">87%</span>
        <div>
          <p class="text-lg md:text-xl text-white/90 font-medium leading-snug">of people don't understand their purpose.</p>
          <p class="text-white/35 text-xs mt-1.5">Lifeway Research</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MARK TWAIN QUOTE ===== -->
  <section class="relative py-16 md:py-20 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8 text-center">
      <blockquote class="reveal">
        <p class="font-display text-2xl md:text-3xl lg:text-4xl text-charcoal italic leading-[1.3]">
          "The two most important days in your life are the day you are born and the day you find out <em class="ember-gradient not-italic">why.</em>"
        </p>
        <footer class="mt-4 text-sm font-semibold text-ember tracking-wide">— Mark Twain</footer>
      </blockquote>
    </div>
  </section>

  <!-- ===== STATEMENT — Big text on white ===== -->
  <section class="relative py-28 md:py-40 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="max-w-5xl">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-8">What We Do</p>
        <p class="reveal reveal-d1 font-display text-3xl md:text-4xl lg:text-[3.5rem] text-charcoal leading-[1.2]">
          We help individuals, families, and organizations <em class="text-ember">uncover purpose</em> and <em class="text-ember">unleash potential</em> through proprietary, visual tools and proven frameworks.
        </p>
        <p class="what-we-do reveal reveal-d2 mt-10 text-base md:text-lg text-stone leading-relaxed max-w-3xl">
          Based in Charleston, South Carolina, Wildfire Leadership offers <a href="/leadership-coaching">leadership coaching</a>, <a href="/workshops">workshops</a>, keynote speaking, and <a href="/facilitators">facilitator certification</a>. It serves schools, businesses, churches, and families. For couples, <a href="https://invest.wildfireleadership.com">INVEST Marriage</a> is a Christ-centered marriage journey created by Bill and Stephanie Lammers. Start with a <a href="/mission-portrait#pricing">Mission Portrait™</a>: $35 self-guided, or $299 with a Certified Facilitator. <a href="/about">Read our story</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== OUR TOOLS — Two proprietary frameworks ===== -->
  <section class="relative py-24 md:py-32 bg-warm-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="text-center mb-16">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">Our Tools</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">Tools that <em>transform.</em></h2>
        <p class="reveal reveal-d2 text-base md:text-lg text-charcoal/70 max-w-xl mx-auto leading-relaxed mt-6">Two <strong class="text-charcoal">proprietary frameworks</strong> designed to help you uncover purpose, build resilience, and ignite lasting change.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 md:gap-5">
        <!-- Mission Portrait™ -->
        <a href="/mission-portrait" class="group reveal block rounded-2xl overflow-hidden bg-white border border-sand/50 card-glow lift">
          <div class="aspect-[16/9] overflow-hidden relative">
            <Img src={missionPortraitGraphic} alt="Mission Portrait™" widths={[400, 660, 1000, 1320]} sizes={coverSizes(missionPortraitGraphic, 16 / 9, [['(min-width: 1400px)', 658, 'px'], ['(min-width: 768px)', 47, 'vw'], ['', 100, 'vw']])} kind="graphic" alpha class="w-full h-full object-cover img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          <div class="relative z-10 p-8 md:p-10">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-mono text-ember tracking-wider">01</span>
              <svg class="w-5 h-5 text-charcoal/20 group-hover:text-ember group-hover:translate-x-1 transition-all duration-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <h3 class="font-display text-2xl md:text-3xl text-charcoal mb-3">Mission Portrait™</h3>
            <p class="text-sm text-stone leading-relaxed">A customized visual daily reminder of your personal mission and purpose. Your map to your true potential.</p>
          </div>
        </a>

        <!-- 7 Igniters™ -->
        <a href="/7-igniters" class="group reveal reveal-d1 block rounded-2xl overflow-hidden bg-white border border-sand/50 card-glow lift">
          <div class="aspect-[16/9] overflow-hidden relative bg-white">
            <Img src={sevenIgnitersGraphic} alt="The 7 Igniters™" widths={[400, 600, 800]} sizes="(min-width: 1400px) 393px, (min-width: 768px) 28vw, 60vw" kind="graphic" class="w-full h-full object-contain img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          <div class="relative z-10 p-8 md:p-10">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-mono text-ember tracking-wider">02</span>
              <svg class="w-5 h-5 text-charcoal/20 group-hover:text-ember group-hover:translate-x-1 transition-all duration-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <h3 class="font-display text-2xl md:text-3xl text-charcoal mb-3">The 7 Igniters™</h3>
            <p class="text-sm text-stone leading-relaxed">A proven seven-step framework from purpose to potential. Each igniter builds on the last.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <StatCounter
    bg="white"
    stats={[
      { value: 50000, suffix: "+", label: "Mission Portrait™s\ncompleted" },
      { value: 87, suffix: "%", label: "Report greater clarity\nand confidence" },
      { value: 92, suffix: "%", label: "Developed a personalized\nroadmap for growth" },
      { value: 70, suffix: "+", label: "Certified facilitators\nin our network" },
    ]}
  />

  <!-- ===== GLOBAL REACH MAP ===== -->
  <MapSection />

  <!-- ===== PORTRAIT SHOWCASE — Gallery-style ===== -->
  <section class="relative py-24 md:py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
        <div>
          <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">Real Stories</p>
          <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
            Over 50,000 portraits.<br/><em>Each one unique.</em>
          </h2>
        </div>
        <div class="reveal reveal-d2">
          <a href="/mission-portrait" class="group inline-flex items-center gap-3 text-sm font-medium tracking-wide text-charcoal link-underline">
            Explore Mission Portrait™s
            <svg class="w-4 h-4 transition-transform duration-400 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      <div class="reveal-scale">
        <PortraitLightbox portraits={[
          { src: portraitColeen, name: "Brenda" },
          { src: portraitZeb, name: "Zeb" },
          { src: portraitSarah, name: "Sarah", alpha: true },
          { src: portraitRyan, name: "Ryan" },
        ]} />
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS — One per sector ===== -->
  <section class="relative py-24 md:py-36 bg-warm-white">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="text-center mb-14">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">What Leaders Are Saying</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">Trusted across <em>every sector.</em></h2>
      </div>
      <div class="grid md:grid-cols-2 gap-4 md:gap-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-3 font-medium">K–12 Education</p>
          <TestimonialCard
            quote="This curriculum is a must for students to learn the process of goal realization."
            name="Bob Morton"
            title="Superintendent, Defiance City Schools"
          />
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-3 font-medium">Higher Education</p>
          <TestimonialCard
            quote="Wildfire's curriculum gives students something most programs miss — real clarity on their purpose and a vision for their future."
            name="Dr. Todd Hernandez"
            title="President, Northwest State Community College"
          />
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-3 font-medium">Business</p>
          <TestimonialCard
            quote="From the field to senior leadership, everyone now understands our purpose — and lives it daily."
            name="Leslie Meyer"
            title="President & Co-Owner, Flatrock Bridge Group"
          />
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-3 font-medium">Faith & Community</p>
          <TestimonialCard
            quote="Wildfire has created a unique tool to help people capture their gifts, passions, and vision."
            name="Greg Surratt"
            title="Co-Founder, ARC"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE SERVE — Four equal paths: businesses, churches, families, schools (Bill, 2026-11-25).
       Each card is a real photo of that room, never an icon (Will, 2026-11-25). ===== -->
  <section class="relative py-24 md:py-32 bg-white" aria-labelledby="who-we-serve-title">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">Who We Serve</p>
      <h2 id="who-we-serve-title" class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05] mb-12 md:mb-14">Purpose for <em>everyone.</em></h2>

      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 md:gap-x-6" role="list">
        {[
          { title: "Businesses", desc: "Align your team around one mission.", href: "/business", src: businessWorkshopClose, alt: "A team member at a Wildfire Leadership business workshop", pos: "50% 20%" },
          { title: "Churches", desc: "Faith-based tools and curriculum for your church.", href: "/faith-community", src: faithWorkshop, alt: "A couple laughing together at a Wildfire faith workshop", pos: "50% 35%" },
          { title: "Families", desc: "A Mission Portrait for your marriage and family.", href: "/family-mission-portrait", src: familyWorkshop, alt: "A family working on their Mission Portrait together", pos: "55% 40%" },
          { title: "Schools", desc: "Ignite Students for K‑12. Ignite Higher Ed for colleges.", href: "/education", src: educationStudents, alt: "A student writing in the Ignite Students workbook", pos: "35% 50%" },
        ].map((item, i) => (
          <li class:list={["reveal", i > 0 && `reveal-d${i}`]}>
            <a href={item.href} class="group block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ember focus-visible:ring-offset-4">
              <div class="aspect-[4/5] md:aspect-[4/3] lg:aspect-[4/5] overflow-hidden rounded-2xl bg-sand/40">
                <Img src={item.src} alt={item.alt} widths={[320, 480, 640, 960]} sizes={coverSizes(item.src, 4 / 5, [['(min-width: 1400px)', 314, 'px'], ['(min-width: 1024px)', 22, 'vw'], ['', 46, 'vw']])} class="w-full h-full object-cover img-hover" style={`object-position: ${item.pos}`} />
              </div>
              <h3 class="mt-5 flex items-center gap-2 font-display text-2xl md:text-[1.75rem] leading-tight text-charcoal group-hover:text-ember transition-colors duration-300">
                {item.title}
                <svg class="w-4 h-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </h3>
              <p class="mt-2 text-sm md:text-[0.95rem] text-stone leading-relaxed max-w-[30ch]">{item.desc}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== PHOTO MOSAIC — Showcase real images from events ===== -->
  <section class="relative py-20 md:py-28 bg-warm-white overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8">
      <div class="text-center mb-14">
        <p class="reveal text-xs font-semibold uppercase tracking-[0.3em] text-ember mb-4">In Action</p>
        <h2 class="reveal reveal-d1 font-display text-4xl md:text-5xl text-charcoal leading-[1.05]">
          Igniting change <em>everywhere.</em>
        </h2>
      </div>
    </div>
    <!-- Edge-to-edge scroll gallery (Porsche-style) -->
    <div class="scroll-gallery px-5 md:px-8 reveal reveal-d2">
      {[
        { src: businessHero, alt: "Business workshop" },
        { src: higherEdWorkshop, alt: "College students working on Mission Portrait™s" },
        { src: heroMain, alt: "Wildfire Leadership event" },
        { src: studentsMissionPortraits, alt: "Students holding their finished Mission Portrait™s" },
        { src: lifestyle, alt: "Mission Portrait™ workbook" },
        { src: businessWorkshopGroup, alt: "Business team in a Wildfire Mission Portrait™ workshop" },
      ].map((img) => (
        <div class="w-[320px] md:w-[420px] aspect-[4/3] rounded-xl overflow-hidden group">
          <Img src={img.src} alt={img.alt} widths={[360, 480, 640, 960, 1280]} sizes={coverSizes(img.src, 4 / 3, [['(min-width: 768px)', 420, 'px'], ['', 320, 'px']])} class="w-full h-full object-cover img-hover" />
        </div>
      ))}
    </div>
  </section>

  <!-- ===== STAKES ===== -->
  <section class="relative py-16 md:py-20 bg-charcoal">
    <div class="max-w-3xl mx-auto px-5 md:px-8 text-center">
      <p class="reveal font-display text-xl md:text-2xl text-white leading-relaxed">
        Without clarity of purpose, teams drift, students disengage, marriages lose direction, and potential goes untapped. <em class="ember-gradient">Purpose changes everything.</em>
      </p>
    </div>
  </section>

  <!-- ===== CTA CLOSER ===== -->
  <CallToAction
    title='Ready to ignite<br/><em class="ember-gradient">your journey?</em>'
    description="Take the first step toward discovering your mission and unlocking your full potential."
    image={lifestyle}
    buttonText="Start with your Mission Portrait"
    buttonHref="/mission-portrait#pricing"
  />

</BaseLayout>

<style>
  .what-we-do a {
    color: var(--color-charcoal);
    text-decoration: underline;
    text-decoration-color: rgba(224, 53, 0, 0.5);
    text-underline-offset: 4px;
  }
  .what-we-do a:hover {
    color: var(--color-ember);
  }
</style>
