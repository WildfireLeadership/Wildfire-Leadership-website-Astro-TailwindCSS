---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { organization, website, breadcrumbList, type Crumb } from '../data/site';
import type { ImageMetadata } from 'astro';
import { heroPreload } from '../lib/images';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Use this exact <title> instead of "{title} | Wildfire Leadership". */
  fullTitle?: string;
  /** Inner pages: the trail after Home, for BreadcrumbList. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page (Service, FAQPage, Person...). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** The hero image (the LCP element), preloaded with the same sources the hero uses. */
  heroImage?: ImageMetadata;
  /** 'home' for the homepage hero, 'page' for PageHero. */
  heroVariant?: 'home' | 'page';
}

const {
  title,
  description = "Wildfire Leadership helps individuals, teams, and organizations uncover purpose and unleash potential through practical, visual tools and proven frameworks.",
  ogImage = "/images/hero-main.jpg",
  fullTitle: fullTitleProp,
  breadcrumbs,
  jsonLd = [],
  noindex = false,
  heroImage,
  heroVariant = 'page',
} = Astro.props;

const preload = heroImage ? await heroPreload(heroImage, heroVariant) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const fullTitle = fullTitleProp ?? `${title} | Wildfire Leadership`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    website,
    ...(breadcrumbs && breadcrumbs.length ? [breadcrumbList(breadcrumbs)] : []),
    ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Canonical -->
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content="Wildfire Leadership" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {preload && (
      <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal, .reveal-left, .reveal-scale').forEach((el) => observer.observe(el));

      // Counters. The HTML already holds the final number, so crawlers, visitors
      // without JavaScript and visitors who prefer reduced motion read the real
      // value. Otherwise reset to 0 here (the row is still hidden by .reveal)
      // and count up once the counter scrolls into view.
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (counters.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const format = (n: number, suffix: string) => n.toLocaleString('en-US') + suffix;
        const counterObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              counterObs.unobserve(el);
              const target = parseInt(el.dataset.count || '0', 10);
              const suffix = el.dataset.suffix || '';
              const start = performance.now();
              const animate = (now: number) => {
                const p = Math.min((now - start) / 2000, 1);
                const eased = 1 - Math.pow(1 - p, 4);
                el.textContent = format(Math.floor(eased * target), suffix);
                if (p < 1) requestAnimationFrame(animate);
              };
              requestAnimationFrame(animate);
            });
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => {
          el.textContent = format(0, el.dataset.suffix || '');
          counterObs.observe(el);
        });
      }
    </script>
  </body>
</html>
