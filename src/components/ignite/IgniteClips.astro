---
/**
 * Student clips and the Mission Portrait video on /schools and /colleges (Bill, 26 November
 * 2026). Each clip names its program, so a visitor knows whether a student was in Ignite Students
 * (K-12) or Ignite Higher Ed. Nothing about a student beyond their first name and program.
 *
 * A still and a play link stand in for each Vimeo player until someone presses play, so the page
 * does not load several players up front. With JavaScript the player opens in place; without it, the
 * link opens the Vimeo player in a new tab. Every Vimeo URL carries dnt=1.
 * The student clips are vertical (9:16 on Vimeo), the Mission Portrait video is 16:9.
 */
import type { ImageMetadata } from 'astro';
import Img from '../Img.astro';

export interface Clip {
  vimeo: string;
  /** Shown in bold: the student's first name, or the video's title. */
  title: string;
  /** The program, shown after the title. */
  program: string;
  /** Visible text of the play link, e.g. "Play Maysa's clip". */
  play: string;
  /** Length as m:ss, from Vimeo. */
  length: string;
  thumb: ImageMetadata;
  alt: string;
  /** CSS object-position for the still. */
  focus?: string;
}

interface Props {
  heading: string;
  lede: string;
  students: Clip[];
  videos: Clip[];
}
const { heading, lede, students, videos } = Astro.props;

const player = (id: string) =>
  `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0&badge=0&vimeo_logo=0&dnt=1`;
const solo = students.length === 1;
---

<section class:list={['band on-field clips', { solo }]} id="students" aria-labelledby="clips-h" data-stage>
  <div class="head">
    <h2 id="clips-h" data-rise>{heading}</h2>
    <p class="lede" data-rise>{lede}</p>
  </div>
  <div class="clipgrid">
    <div class="reels">
      {students.map((c) => (
        <figure class="clip tall" data-rise>
          <div class="frame">
            <Img src={c.thumb} alt={c.alt} widths={[280, 420, 560]} sizes="(min-width: 980px) 280px, 62vw" style={c.focus && `object-position:${c.focus}`} />
            <a class="play" href={player(c.vimeo)} target="_blank" rel="noopener" data-vimeo={c.vimeo} data-title={`${c.title}, ${c.program}`}>
              <span>{c.play}</span>
            </a>
          </div>
          <figcaption><span><b>{c.title}</b> · {c.program}</span><span class="len">{c.length}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="wides">
      {videos.map((c) => (
        <figure class="clip wide" data-rise>
          <div class="frame">
            <Img src={c.thumb} alt={c.alt} widths={[400, 600, 800]} sizes="(min-width: 980px) 420px, calc(100vw - 32px)" style={c.focus && `object-position:${c.focus}`} />
            <a class="play" href={player(c.vimeo)} target="_blank" rel="noopener" data-vimeo={c.vimeo} data-title={c.title}>
              <span>{c.play}</span>
            </a>
          </div>
          <figcaption><span><b>{c.title}</b> · {c.program}</span><span class="len">{c.length}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
