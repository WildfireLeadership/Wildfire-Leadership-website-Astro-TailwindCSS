---
interface Props {
  name: string;
  title?: string;
  as?: 'div' | 'figcaption';
  dark?: boolean;
  class?: string;
}

const { name, title, as: Tag = 'div', dark = false, class: className } = Astro.props;
---

<Tag class:list={['attribution', { dark }, className]}>
  <span class="name">{name}</span>
  {title && <span class="role">{title}</span>}
</Tag>

<style>
  .attribution {
    display: grid;
    gap: 4px;
    color: var(--color-charcoal);
  }

  .attribution.dark {
    color: #fff;
  }

  .name {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .role {
    color: #625b50;
    font-size: 14px;
    line-height: 1.45;
  }

  .dark .role {
    color: #cfc8bc;
  }
</style>
